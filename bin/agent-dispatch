#!/usr/bin/env python3
"""
agent-dispatch v2: Production-hardened cross-harness headless orchestrator.

Pipeline:
  Linear Ticket -> Preflight + Locks + Worktree + Bootstrap ->
  Base Baseline Verify -> Worker (Codex/OpenCode/Pi/Antigravity) ->
  Orchestrator Secret-Scanned Commit (fixed candidate_sha) ->
  Protected-Paths + Deterministic Test-Integrity + Mandatory Verify ->
  Cross-Vendor Two-Axis Review (against immutable orchestrator artifacts & base_sha..candidate_sha) ->
  Post-Review Immutability Check -> Bounded Rework (1 initial + max_rework rounds) ->
  Idempotent Option B Publish (Fast-Forward Push + Open Draft PR + Verified Linear In Review)
  with Stage Checkpoint Reconciliation (`resume`).
"""

from __future__ import annotations

import argparse
