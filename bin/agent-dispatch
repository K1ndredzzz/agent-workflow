#!/usr/bin/env python3
"""
agent-dispatch v5: Production-grade cross-harness headless orchestrator.

Pipeline:
  Preflight (Project + Dirty Docs + Remote FF + Verify Detect + Bootstrap + Real Base Baseline) ->
  Canonical Repo & Ticket Flock Locks (worktree owner.json inside repo lock) ->
  Fresh Post-Preflight Claim (skipped in --no-push) ->
  Worker (Codex/OpenCode/Pi/Antigravity, streaming logs + instant sessions.jsonl) ->
  Branch/History Check + Secret-Checked Orchestrator Commit (hooks/fsmonitor disabled) ->
  Full-Range Untruncated Secret Scan (diffs + commit msgs + merges) ->
  Granular Protected-Paths + Deterministic Test-Integrity (-z NUL-safe) + Mandatory Verify ->
  Cross-Vendor Read-Only Two-Axis Review (pre-generated diff.patch + SHA-256 verified artifacts) ->
  Post-Review Worktree, Artifact & Ownership Verification -> Bounded Rework (1 + max_rework) ->
  True Remote-Reconciled Option B Delivery (Pre-Push PR Guard + FF Push + Verified Open Draft PR
  + Human-State-Safe Linear In Review + Atomic Label Cleanup + Idempotent Delivery Comment)
  with Atomic Checkpoints (`resume`).
"""

