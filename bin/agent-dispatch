#!/usr/bin/env python3
"""
agent-dispatch v3: Production-grade cross-harness headless orchestrator.

Pipeline:
  Preflight (Project + Dirty Docs + Remote FF + Verify Detect + Bootstrap + Base Baseline) ->
  Canonical Repo & Ticket Flock Locks -> Claim Linear (skipped in --no-push) ->
  Worker (Codex/OpenCode/Pi/Antigravity, streaming logs + instant sessions.jsonl) ->
  Orchestrator Commit + Full-Range Untruncated Secret Scan ->
  Protected-Paths (--no-renames) + Deterministic Test-Integrity (--no-renames) + Mandatory Verify ->
  Cross-Vendor Read-Only Two-Axis Review (pre-generated diff.patch + verified immutable artifacts) ->
  Post-Review Worktree & External Mutation Verification -> Bounded Rework (1 + max_rework) ->
  True Remote-Reconciled Option B Delivery (FF Push + Verified Open Draft PR + Live Linear In Review
  + Label Cleanup + Idempotent Delivery Comment) with Atomic Checkpoints (`resume`).
"""

