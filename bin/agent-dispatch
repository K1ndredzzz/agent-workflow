def _test_source_files(worktree: Path) -> Iterator[Path]:
    for root, dirs, names in os.walk(worktree):
        dirs[:] = [d for d in dirs if d not in {".git", ".venv", "venv", "node_modules", "__pycache__", ".tox"}]
        for name in names:
            if (name.endswith(".py") and (name.startswith("test") or name.endswith("_test.py"))) or re.search(
                r"\.(?:test|spec)\.[cm]?[jt]sx?$", name
            ):
                yield Path(root) / name


def _unittest_can_discover(tests_dir: Path, files: list[Path]) -> bool:
    for path in files:
        if not path.is_relative_to(tests_dir) or not path.name.startswith("test"):
            return False
        if any(not (p / "__init__.py").is_file() for p in path.parents if p.is_relative_to(tests_dir) and p != tests_dir):
            return False
        try:
            module = ast.parse(path.read_bytes(), filename=str(path))
        except (SyntaxError, ValueError):
            return False
        case_types = {"unittest.TestCase", "unittest.IsolatedAsyncioTestCase"}
        for node in module.body:
            if isinstance(node, ast.ImportFrom) and node.module == "unittest":
                case_types.update(a.asname or a.name for a in node.names if "unittest." + a.name in case_types)
            if isinstance(node, ast.Import):
                for alias in node.names:
                    if alias.name == "unittest" and alias.asname:
                        case_types.update({alias.asname + ".TestCase", alias.asname + ".IsolatedAsyncioTestCase"})
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name.startswith("test"):
                return False
            if isinstance(node, ast.ClassDef):
                if any(ast.unparse(base) in case_types for base in node.bases):
                    case_types.add(node.name)
                elif node.name.startswith("Test"):
                    return False
        if any(isinstance(n, ast.ImportFrom) and n.module == "pytest" or
               isinstance(n, ast.Import) and any(a.name == "pytest" for a in n.names) for n in ast.walk(module)):
            return False
    return bool(files)


def _repo_has_js_tests(worktree: Path) -> bool:
    if any(p.suffix != ".py" for p in _test_source_files(worktree)):
        return True
    for d in ("tests", "test", "__tests__"):
        root = worktree / d
        if not root.is_dir():
            continue
        files = [
            p for p in root.rglob("*")
            if p.is_file() and "__pycache__" not in p.parts
        ]
        # Empty test dir or any non-Python file signals possible JS tests;
        # a tests/ dir containing exclusively Python files belongs to Python.
        if not files or any(p.suffix not in (".py", ".pyc") for p in files):
            return True
    return False


def detect_verify_command(worktree: Path, explicit_cmd: str | None) -> str | None:
    if explicit_cmd:
        return explicit_cmd

    for jf in ("justfile", "Justfile"):
        p = worktree / jf
        if p.is_file():
            txt = p.read_text(encoding="utf-8", errors="ignore")
            for target in ("verify", "check"):
                if re.search(rf"^{target}(?:\s+[^:=\n]*)?:(?!=)", txt, re.M):
                    return f"just {target}"

    mf = worktree / "Makefile"
    if mf.is_file():
        txt = mf.read_text(encoding="utf-8", errors="ignore")
        for target in ("verify", "check"):
            if re.search(rf"^{target}\s*:(?!=)", txt, re.M):
                return f"make {target}"

    commands: list[str] = []
    pkg = worktree / "package.json"
    if pkg.is_file():
        try:
            scripts = json.loads(pkg.read_text(encoding="utf-8")).get("scripts", {})
            if (worktree / "pnpm-lock.yaml").is_file():
                pm = "pnpm"
            elif (worktree / "bun.lockb").is_file() or (worktree / "bun.lock").is_file():
                pm = "bun run"
            elif (worktree / "yarn.lock").is_file():
                pm = "yarn"
            else:
                pm = "npm run"
            js_cmds = [f"{pm} {s}" for s in ("typecheck", "lint", "test") if s in scripts]
            # Never pass lint-only JS repo if JS test files/dirs exist without a `test` script!
            if "test" not in scripts and _repo_has_js_tests(worktree):
                return None
            commands.extend(js_cmds)
        except (OSError, ValueError, AttributeError, TypeError):
            return None

    if (worktree / "Cargo.toml").is_file():
        commands.extend(["cargo clippy --all-targets", "cargo test"])

    python_config = (worktree / "pyproject.toml").is_file() or (worktree / "pytest.ini").is_file()
    py_tests = [p for p in _test_source_files(worktree) if p.suffix == ".py"]
    if python_config or py_tests:
        if python_config and shutil.which("ruff"):
            commands.append("ruff check .")
        if (worktree / ".venv" / "bin" / "pytest").is_file():
            commands.append(".venv/bin/pytest")
        elif (worktree / "uv.lock").is_file() and shutil.which("uv"):
            commands.append("uv run pytest")
        elif not python_config and _unittest_can_discover(worktree / "tests", py_tests):
            commands.append("python3 -m unittest discover -s tests")
        elif shutil.which("pytest"):
            commands.append("pytest")
        elif _unittest_can_discover(worktree / "tests", py_tests):
            commands.append("python3 -m unittest discover -s tests")
        elif py_tests or (worktree / "tests").is_dir() or (worktree / "pytest.ini").is_file():
            return None

    if (worktree / "go.mod").is_file():
        commands.extend(["go vet ./...", "go test ./..."])

    return " && ".join(commands) or None


def _untracked_files(worktree: Path, *, ignore_shutdown: bool = False) -> set[str]:
    listing = run_cmd(git_cmd("ls-files", "--others", "--exclude-standard", "-z"),
                      cwd=worktree, check=True, env_role="orchestrator", cap_output=False, ignore_shutdown=ignore_shutdown)
    return set(listing.stdout.split("\0")) - {""}


def _file_identity(path: Path) -> tuple[int, int, int, int]:
    st = path.lstat()
    return st.st_dev, st.st_ino, st.st_ctime_ns, st.st_size


def _release_setup_files(worktree: Path, files: dict[str, tuple[int, int, int, int]]) -> None:
    if not files:
        return
    try:
        wt_resolved = worktree.resolve()
        for name in files.keys() & _untracked_files(worktree, ignore_shutdown=True):
            path = worktree / name
            if path.parent.resolve().is_relative_to(wt_resolved) and (path.is_file() or path.is_symlink()):
                if _file_identity(path) == files[name]:
                    path.unlink()
    except (OSError, RuntimeError) as exc:
        log(f"Could not release setup output: {redact_secrets(str(exc))}")


def run_verify_gate(
    worktree: Path,
    verify_cmd: str | None,
    *,
    allow_no_verify: bool,
    log_file: Path,
    repo_key: str,
    timeout: int = 900,
) -> dict[str, Any]:
    if not verify_cmd:
        if allow_no_verify:
            return {"ran": False, "passed": True, "command": None, "returncode": 0, "output": "Bypassed via --allow-no-verify."}
        return {
            "ran": False,
            "passed": False,
            "command": None,
            "returncode": 1,
            "output": "No verification command detected. Pass --verify-cmd or configure a repo check script (or --allow-no-verify).",
        }
    log(f"Running verification gate: {verify_cmd}")
    with file_lock(_cache_root() / "locks" / f"verify-{repo_key}.lock", blocking=True):
        original, dirty_before = tracked_status(worktree)
        if dirty_before:
            raise RuntimeError("Verification requires tracked files to match the candidate commit. Existing edits were preserved.")
        prior_files = _untracked_files(worktree)
        try:
            res = run_cmd(
                verify_cmd, cwd=worktree, shell=True, timeout=timeout, env_role="child",
                stdout_path=log_file, stderr_path=log_file.with_suffix(".stderr.log"),
            )
            rc = res.returncode
            output = (res.stdout + "\n" + res.stderr).strip()
        except subprocess.TimeoutExpired:
            rc = 124
            output = f"Verification timed out after {timeout}s (see {log_file})."

        branch, dirty_after = tracked_status(worktree)
        if branch != original:
            raise RuntimeError("Verification changed the worktree branch or HEAD. Inspect the worktree before rerunning.")
        passed = rc == 0
        if dirty_after:
            run_cmd(git_cmd("reset", "--hard", "HEAD"), cwd=worktree, check=True, env_role="orchestrator")
            if passed:
                passed = False
                output = "Verification mutated tracked files: " + repr(dirty_after[:5])
        added = sorted(_untracked_files(worktree) - prior_files)
        for offset in range(0, len(added), 100):
            run_cmd(git_cmd("--literal-pathspecs", "clean", "-fd", "-e", ".dispatch", "--", *added[offset:offset + 100]),
                    cwd=worktree, check=True, env_role="orchestrator")
        if passed and "unittest discover" in verify_cmd and re.search(r"^Ran 0 tests? in ", output, re.M):
            passed = False
            output = "unittest discovery collected zero tests."
        return {"ran": True, "passed": passed, "command": verify_cmd, "returncode": rc,
                "output": redact_secrets(output)[-4000:]}


def check_base_baseline(
    repo_root: Path,
    repo_key: str,
    worktree: Path,
    base_sha: str,
    verify_cmd: str | None,
    run_dir: Path,
    *,
    setup_cmd_override: str | None = None,
    setup_timeout: int = 600,
    allow_no_verify: bool = False,
    timeout: int = 900,
) -> dict[str, Any]:
    baselines_file = _cache_root() / "baselines.json"
    baselines_lock = _cache_root() / "locks" / "baselines.lock"
    lease_key = sha256_text(json.dumps([repo_key, base_sha, verify_cmd, setup_cmd_override]))
    key_lock = _cache_root() / "locks" / f"baseline-{lease_key[:16]}.lock"

    def read_cache() -> dict[str, bool]:
        try:
            cache = json.loads(baselines_file.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return {}
        return cache if isinstance(cache, dict) else {}

    with file_lock(key_lock, blocking=True):
        # The explicit command already identifies the recipe and its existing cache entries.
        cache_key = lease_key
        if verify_cmd:
            with file_lock(baselines_lock, blocking=True):
                if read_cache().get(cache_key) is True:
                    return {"checked": True, "cached": True, "passed": True}

        head = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=worktree, check=True, env_role="orchestrator").stdout.strip()
        target_wt = worktree
        temp_wt: Path | None = None
        try:
            if head != base_sha:
                # Reused feature branch with baseline cache miss: verify base_sha in a UNIQUE temporary detached worktree!
                temp_wt = _worktree_cache_path(repo_key, f".baseline-{base_sha[:10]}-{os.getpid()}-{uuid.uuid4().hex[:8]}")
                owner_file = _cache_root() / "baseline-owners" / repo_key / temp_wt.name
                with file_lock(_cache_root() / "locks" / f"repo-{repo_key}.lock", blocking=True):
                    atomic_write_text(owner_file, json.dumps({"key": lease_key, "base_sha": base_sha}))
                    run_cmd(git_cmd("worktree", "add", "--detach", str(temp_wt), base_sha), cwd=repo_root, check=True, env_role="orchestrator")
                bootstrap_worktree(temp_wt, setup_cmd_override, timeout=setup_timeout)
                target_wt = temp_wt

            head_before = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=target_wt, check=True, env_role="orchestrator").stdout.strip()
            if head_before != base_sha:
                raise RuntimeError("Bootstrap changed the baseline HEAD before verification")
            if not verify_cmd:
                verify_cmd = detect_verify_command(target_wt, None)
                cache_key = sha256_text(json.dumps([lease_key, verify_cmd]))
                with file_lock(baselines_lock, blocking=True):
                    if read_cache().get(cache_key) is True:
                        return {"checked": True, "cached": True, "passed": True}
            log(f"Checking clean base baseline ({base_sha[:8]}): {verify_cmd}")
            res = run_verify_gate(
                target_wt,
                verify_cmd,
                allow_no_verify=allow_no_verify,
                log_file=run_dir / "baseline-verify.log",
                repo_key=repo_key,
                timeout=timeout,
            )
        finally:
            if temp_wt is not None:
                with file_lock(_cache_root() / "locks" / f"repo-{repo_key}.lock", ignore_shutdown=True):
                    _worktree_cache_path(repo_key, temp_wt.name)
                    run_cmd(git_cmd("worktree", "remove", "--force", str(temp_wt)), cwd=repo_root, env_role="orchestrator", ignore_shutdown=True)
                    if not temp_wt.exists():
                        owner_file.unlink(missing_ok=True)
                    else:
                        log(f"Baseline worktree still registered for cleanup: {temp_wt}")

        if res["passed"] and res["ran"]:
            with file_lock(baselines_lock, blocking=True):
                cache = read_cache()
                cache[cache_key] = True
                atomic_write_text(baselines_file, json.dumps(cache, indent=2))
        return {"checked": True, "cached": False, **res}


def check_protected_paths(
    worktree: Path,
    base_sha: str,
    candidate_sha: str,
    *,
    allowed_patterns: list[str] | None = None,
    allow_all: bool = False,
) -> list[str]:
    """Use --no-renames -z (NUL-safe for non-ASCII/special paths); supports granular allowlist patterns."""
    if allow_all:
        return []
    pats = allowed_patterns or []
    raw = run_cmd(
        git_cmd(
            "diff", "--no-renames", "--no-ext-diff", "--no-textconv", "-z", "--name-only", f"{base_sha}..{candidate_sha}",
            attr_source=base_sha,
        ),
        cwd=worktree,
        check=True,
        env_role="orchestrator",
        cap_output=False,
    ).stdout
    changed = [f for f in raw.split("\x00") if f]
    violations: list[str] = []
    for f in changed:
        if pats and path_matches_any_pattern(f, pats):
            continue
        base_name = Path(f).name
        if (
            f in PROTECTED_EXACT_FILES
            or base_name in PROTECTED_BASENAMES
            or any("/" + p in "/" + f for p in PROTECTED_PREFIXES)
            or any(r.search(f) for r in PROTECTED_REGEXES)
        ):
            violations.append(f"Protected gate/policy file modified: {f}")
        elif base_name == "package.json":
            old_raw = run_cmd(git_cmd("show", f"{base_sha}:{f}"), cwd=worktree, env_role="orchestrator", cap_output=False)
            new_raw = run_cmd(git_cmd("show", f"{candidate_sha}:{f}"), cwd=worktree, env_role="orchestrator", cap_output=False)
            if new_raw.returncode == 0:
                try:
                    new_pkg = json.loads(new_raw.stdout)
                except json.JSONDecodeError as exc:
                    violations.append(f"Invalid JSON in `{f}`: {exc}")
                    continue
                if not isinstance(new_pkg, dict):
                    violations.append(f"Invalid JSON object in `{f}`")
                    continue
            else:
                new_pkg = {}
            if old_raw.returncode == 0:
                try:
                    old_pkg = json.loads(old_raw.stdout)
                except json.JSONDecodeError:
                    old_pkg = {}
                if not isinstance(old_pkg, dict):
                    old_pkg = {}
                for section in ("scripts", "jest", "vitest", "eslintConfig"):
                    if old_pkg.get(section) != new_pkg.get(section):
                        violations.append(f"Protected `{f}` `{section}` section modified")
            else:
                # Workspace packages can introduce gate scripts too.
                if any(new_pkg.get(s) is not None for s in ("scripts", "jest", "vitest", "eslintConfig")):
                    violations.append(f"Protected `{f}` gate/script config added")
    return violations


def _parse_nul_name_status(raw: str) -> list[tuple[str, str]]:
    tokens = [t for t in raw.split("\x00") if t]
    pairs: list[tuple[str, str]] = []
    i = 0
    while i + 1 < len(tokens):
        pairs.append((tokens[i], tokens[i + 1]))
        i += 2
    return pairs


def check_test_integrity_diff(
    worktree: Path,
    base_sha: str,
    candidate_sha: str,
    *,
    allowed_patterns: list[str] | None = None,
    allow_all: bool = False,
) -> list[str]:
    """Deterministically detect deleted test files or added skip/only/ignore markers (NUL-safe, granular allowlist)."""
    if allow_all:
        return []
    pats = allowed_patterns or []
    findings: list[str] = []
    raw_status = run_cmd(
        git_cmd(
            "diff", "--no-renames", "--no-ext-diff", "--no-textconv", "-z", "--name-status", f"{base_sha}..{candidate_sha}",
            attr_source=base_sha,
        ),
        cwd=worktree,
        check=True,
        env_role="orchestrator",
        cap_output=False,
    ).stdout
    test_files: list[str] = []
    for st, path in _parse_nul_name_status(raw_status):
        if pats and path_matches_any_pattern(path, pats):
            continue
        if st.startswith("D") and TEST_FILE_RE.search(path):
            findings.append(f"Deleted test file: {path}")
        elif TEST_FILE_RE.search(path):
            test_files.append(path)

    if test_files:
        for tf in test_files:
            diff_txt = run_cmd(
                git_cmd(
                    "--literal-pathspecs", "diff", "--text", "--no-renames", "--no-ext-diff", "--no-textconv", "--no-color",
                    "-U0", f"{base_sha}..{candidate_sha}", "--", tf,
                    attr_source=base_sha,
                ),
                cwd=worktree,
                check=True,
                env_role="orchestrator",
                cap_output=False,
            ).stdout
            for added in _added_patch_lines(diff_txt):
                if any(pat.search(added) for pat in TEST_SKIP_PATTERNS):
                    findings.append(f"Added test skip/only/ignore marker in {tf}: {redact_secrets(added.strip())[:120]}")
    return findings


def _added_patch_lines(patch: str) -> Iterator[str]:
    # Git headers are outside hunks. A source line may itself begin with '++'.
    in_hunk = False
    for line in patch.split("\n"):
        if line.startswith("diff --git "):
            in_hunk = False
        elif line.startswith("@@ "):
            in_hunk = True
        elif in_hunk and line.startswith("+"):
            yield line[1:]


def _git_text_views(data: bytes) -> Iterator[str]:
    yield data.decode("utf-8", errors="replace")
    if not re.search(rb"(?:[ -~]\x00){3}|(?:\x00[ -~]){3}", data):
        return
    # Git splits at the LF byte, including inside UTF-16 code units. Try each initial
    # alignment and carry it across the physical lines.
    lines = data.split(b"\n")
    for encoding in ("utf-16-le", "utf-16-be"):
        for offset in (0, 1):
            decoded = []
            for line in lines:
                end = len(line) - (len(line) - offset) % 2
                decoded.append(line[offset:end].decode(encoding, errors="replace").lstrip("\ufeff"))
                offset = (offset + len(line) + 1) % 2
            yield "\n".join(decoded)


def _scan_git_bytes(data: bytes, field: str) -> list[str]:
    for text in _git_text_views(data):
        hits = scan_text_for_secrets(text, field)
        if hits:
            return hits
    return []


def _resolve_attr_source(worktree: Path, attr_source: str | None, *, ignore_shutdown: bool = False) -> str | None:
    if attr_source:
        return attr_source
    res = run_cmd(
        git_cmd("rev-parse", "--verify", "-q", "HEAD"),
        cwd=worktree,
        env_role="orchestrator",
        ignore_shutdown=ignore_shutdown,
    )
    return "HEAD" if res.returncode == 0 else None


def _scan_git_changes_for_secrets(
    worktree: Path,
    command: list[str],
    *,
    ignore_shutdown: bool = False,
    attr_source: str | None = None,
) -> list[str]:
    flags = ["--no-renames", "--no-ext-diff", "--no-textconv", "--no-color"]
    effective_attr = _resolve_attr_source(worktree, attr_source, ignore_shutdown=ignore_shutdown)

    paths = run_cmd(
        git_cmd(*command, *flags, "-z", "--diff-filter=AMT", "--name-only", attr_source=effective_attr),
        cwd=worktree, check=True, env_role="orchestrator", cap_output=False, ignore_shutdown=ignore_shutdown,
    ).stdout
    findings: set[str] = set()
    for path in set(paths.split("\0")) - {""}:
        findings.update(scan_text_for_secrets(path, "changed file name", allow_marker=False))
        if _is_secret_filename(path):
            findings.add(f"Potential secret file: {redact_secrets(path)}")

    # --text scans content even when Git would hide the patch because of NUL or attributes.
    patch = run_cmd(
        git_cmd(*command, *flags, "-p", "--text", "-U0", attr_source=effective_attr),
        cwd=worktree, check=True, env_role="orchestrator", cap_output=False,
        stdout_encoding="latin-1", ignore_shutdown=ignore_shutdown,
    ).stdout
    for block in ("\n" + patch).split("\ndiff --git ")[1:]:
        added = "\n".join(_added_patch_lines(block)).encode("latin-1")
        findings.update(_scan_git_bytes(added, "added file content"))
    return sorted(findings)


def scan_range_for_secrets(worktree: Path, base_sha: str, candidate_sha: str) -> list[str]:
    revision_range = f"{base_sha}..{candidate_sha}"
    messages = run_cmd(
        git_cmd("log", "--pretty=format:%B%n", revision_range), cwd=worktree,
        check=True, env_role="orchestrator", cap_output=False,
    ).stdout
    return scan_text_for_secrets(messages, "commit message", allow_marker=False) + _scan_git_changes_for_secrets(
        worktree, ["log", "-m", "--format=", revision_range], attr_source=base_sha
    )


def scan_staged_for_secrets(worktree: Path, *, attr_source: str | None = None) -> list[str]:
    return _scan_git_changes_for_secrets(worktree, ["diff", "--cached"], attr_source=attr_source)


def _scan_before_git_write(
    worktree: Path,
    *,
    for_stash: bool = False,
    exclude_paths: set[str] | frozenset[str] = frozenset(),
    attr_source: str | None = None,
) -> list[str]:
    # stash -u records three trees: index, tracked working copy, and untracked files.
    findings = _scan_git_changes_for_secrets(worktree, ["diff", "HEAD"], ignore_shutdown=for_stash, attr_source=attr_source)
    if for_stash:
        findings.extend(_scan_git_changes_for_secrets(worktree, ["diff", "--cached"], ignore_shutdown=True, attr_source=attr_source))
    untracked = run_cmd(
        git_cmd("ls-files", "--others", "--exclude-standard", "-z"),
        cwd=worktree, check=True, env_role="orchestrator", cap_output=False, ignore_shutdown=for_stash,
    ).stdout
    for name in filter(None, untracked.split("\0")):
        if name in exclude_paths:
            continue
        findings.extend(scan_text_for_secrets(name, "untracked file name", allow_marker=False))
        if _is_secret_filename(name):
            findings.append(f"Potential secret file: {redact_secrets(name)}")
            continue
        path = worktree / name
        if path.is_symlink():
            try:
                content = os.readlink(path)
            except OSError:
                findings.append(f"Unable to read untracked symlink: {redact_secrets(name)}")
                continue
            if _is_secret_filename(content):
                findings.append(f"Potential secret symlink target: {redact_secrets(name)}")
                continue
            findings.extend(scan_text_for_secrets(content, "untracked symlink target", allow_marker=False))
        elif path.is_file():
            try:
                findings.extend(_scan_git_bytes(path.read_bytes(), "untracked file content"))
            except OSError:
                findings.append(f"Unable to read untracked file for secret scan: {redact_secrets(name)}")
                continue
        else:
            findings.append("Unable to scan untracked entry as a regular file or symbolic link")
            continue
    return findings


def orchestrator_commit(
    worktree: Path,
    identifier: str,
    title: str,
    attempt: int,
    *,
    setup_paths: tuple[str, ...] = (),
    attr_source: str | None = None,
) -> tuple[str, list[str]]:
    """Stage & commit changes safely (hooks/fsmonitor disabled; scans commit msg + staged diff). Returns (head_sha, violations)."""
    ensure_dispatch_excluded(worktree)
    commit_msg = f"{identifier}: {title} (attempt {attempt})"
    msg_secret_hits = scan_text_for_secrets(commit_msg, "ticket title / commit message", allow_marker=False)
    if msg_secret_hits:
        head = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=worktree, check=True, env_role="orchestrator").stdout.strip()
        return head, msg_secret_hits
    status = run_cmd(git_cmd("status", "--porcelain"), cwd=worktree, check=True, env_role="orchestrator").stdout.strip()
    if status:
        secret_hits = _scan_before_git_write(worktree, exclude_paths=frozenset(setup_paths), attr_source=attr_source)
        if secret_hits:
            head = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=worktree, check=True, env_role="orchestrator").stdout.strip()
            return head, secret_hits
        if setup_paths:
            # Explicit literal excludes work for names containing whitespace, glob or pathspec characters.
            pathspec = "\0".join([".", *(f":(top,exclude,literal){p}" for p in setup_paths)]) + "\0"
            run_cmd(git_cmd("add", "-A", "--pathspec-from-file=-", "--pathspec-file-nul"), cwd=worktree,
                    stdin_text=pathspec, check=True, env_role="orchestrator")
            run_cmd(git_cmd("--literal-pathspecs", "reset", "-q", "--pathspec-from-file=-", "--pathspec-file-nul"),
                    cwd=worktree, stdin_text="\0".join(setup_paths) + "\0", check=True, env_role="orchestrator")
        else:
            run_cmd(git_cmd("add", "-A"), cwd=worktree, check=True, env_role="orchestrator")
        run_cmd(git_cmd("reset", "-q", "--", ".dispatch"), cwd=worktree, env_role="orchestrator")
        staged = run_cmd(git_cmd("diff", "--cached", "-z", "--name-only"), cwd=worktree, check=True, env_role="orchestrator").stdout
        if staged.strip("\x00"):
            secret_hits = scan_staged_for_secrets(worktree, attr_source=attr_source)
            if secret_hits:
                run_cmd(git_cmd("reset", "-q"), cwd=worktree, env_role="orchestrator")
                head = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=worktree, check=True, env_role="orchestrator").stdout.strip()
                return head, secret_hits
            run_cmd(
                git_cmd("commit", "--no-verify", "-m", commit_msg),
                cwd=worktree,
                check=True,
                env_role="orchestrator",
            )
    head = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=worktree, check=True, env_role="orchestrator").stdout.strip()
    return head, []


# ---------------------------------------------------------------------------
# Strict JSON Extraction, Schema Validation & Headless Harness Drivers
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Prompt Builders & Two-Axis Review
# ---------------------------------------------------------------------------

def build_worker_prompt(
    identifier: str,
    brief_path: Path,
    verify_cmd: str | None,
    *,
    allow_gate_edits: bool,
    standard_paths: list[Path],
    authorized_gate_patterns: list[str] | None = None,
    feedback: str | None = None,
) -> str:
    tdd_rules = PRELOADED_REFS["tdd"]
    verify_line = f"Run `{verify_cmd}` before finishing." if verify_cmd else "Run the repository tests and typecheck before finishing."
    protected_summary = ", ".join(sorted(PROTECTED_EXACT_FILES | PROTECTED_BASENAMES))
    if allow_gate_edits:
        gate_line = "- Gate/policy file edits are explicitly enabled via CLI flag for this ticket; keep changes minimal and justified."
    elif authorized_gate_patterns:
        pats_str = ", ".join(f"`{p}`" for p in authorized_gate_patterns)
        gate_line = (
            f"- ONLY these protected paths are authorized for editing by the ticket brief: {pats_str}. "
            f"Do NOT modify any other protected gate/policy files ({protected_summary}, `docs/adr/*`, `.github/workflows/*`, `*.mk`, or `package.json` gate sections)."
        )
    else:
        gate_line = f"- Do NOT modify protected gate/policy files ({protected_summary}, `docs/adr/*`, `.github/workflows/*`, `*.mk`, or `package.json` gate sections)."
    lines = [
        f"You are implementing Linear ticket {identifier} inside an isolated git worktree.",
        "",
        "## Required Reading First",
        f"1. Read `{brief_path}` (authoritative ticket specification; treat Parent Spec section as background context only).",
        "2. Read the redacted baseline standards, glossary, and active ADR snapshots listed here:",
        *([f"- `{path}`" for path in standard_paths] or ["- (none present in baseline)"]),
        "",
        "## Execution Rules",
        "- Minimal complete change: satisfy ONLY the ticket's acceptance criteria.",
        "- Record independent bugs or cleanup opportunities in `discovered_issues`; leave unrelated files untouched.",
        gate_line,
        f"- {verify_line}",
        "- Leave `git commit` and `git push` to the orchestrator (leave your tested edits cleanly in the worktree).",
        "",
        "## TDD Reference",
        tdd_rules.strip(),
    ]
    if feedback:
        lines += ["", "## Mandatory Rework Feedback (address every item below)", feedback.strip()]
    lines += ["", "Return ONLY a JSON object matching the required schema."]
    return "\n".join(lines) + "\n"


def run_two_axis_review(
    reviewer: HarnessSpec,
    worktree: Path,
    run_dir: Path,
    base_sha: str,
    candidate_sha: str,
    auth_brief_path: Path | None,
    auth_brief_sha256: str | None,
    baseline_std_dir: Path,
    baseline_std_hashes: dict[str, str],
    round_num: int,
    *,
    prior_findings: dict[str, list[str]] | None = None,
    pr_feedback: str | None = None,
    trace_sink: list[dict[str, Any]] | None = None,
    review_timeout: int = 900,
    block_added_secrets: bool = False,
    setup_files: dict[str, tuple[int, int, int, int]] | None = None,
) -> dict[str, Any]:
    # Pre-generate immutable diff.patch; block added secrets (for standalone `review`) and redact deleted secret lines before any LLM sees them!
    diff_patch_path = run_dir / f"diff-r{round_num}.patch"
    diff_output = run_cmd(
        git_cmd(
            "diff", "--no-renames", "--no-ext-diff", "--no-textconv", "--no-color", f"{base_sha}..{candidate_sha}",
            attr_source=base_sha,
        ),
        cwd=worktree,
        check=True,
        env_role="orchestrator",
        cap_output=False,
        stdout_encoding="latin-1",
    ).stdout.encode("latin-1")
    raw_diff_text = diff_output.decode("utf-8", errors="replace")
    if block_added_secrets:
        added_secret_hits = scan_range_for_secrets(worktree, base_sha, candidate_sha)
        if added_secret_hits:
            raise RuntimeError(
                "Refusing to send candidate diff containing added secrets to reviewer:\n"
                + "\n".join(f"- {h}" for h in sorted(set(added_secret_hits)))
            )
    diff_text = redact_secrets(raw_diff_text)
    if "\x00" in raw_diff_text:
        # A diff attribute can force UTF-16 text, including removed credentials, into the review patch.
        # Preserve BOMs as such: UTF-8 replacement characters would hide a header at column one.
        ascii_view = (diff_output.replace(codecs.BOM_UTF16_LE, codecs.BOM_UTF8)
                      .replace(codecs.BOM_UTF16_BE, codecs.BOM_UTF8)
                      .replace(b"\x00", b"").decode("utf-8", errors="replace"))
        safe_view = redact_secrets(ascii_view)
        if safe_view != ascii_view:
            diff_text = safe_view
    diff_redacted_for_review = diff_text != raw_diff_text
    atomic_write_text(diff_patch_path, diff_text)
    diff_patch_sha256 = sha256_file(diff_patch_path)
    artifact_hashes = {baseline_std_dir / rel: digest for rel, digest in baseline_std_hashes.items()}
    artifact_hashes[diff_patch_path] = diff_patch_sha256
    if auth_brief_path is not None:
        if auth_brief_sha256 is None:
            raise RuntimeError("Missing digest for the authoritative review brief.")
        artifact_hashes[auth_brief_path] = auth_brief_sha256
    for path, digest in artifact_hashes.items():
        assert_sha256_intact(path, digest, path.name)

    commits = run_cmd(
        git_cmd("log", f"{base_sha}..{candidate_sha}", "--oneline"), cwd=worktree, check=True, env_role="orchestrator"
    ).stdout.strip()
    diff_stat = run_cmd(
        git_cmd(
            "diff", "--no-ext-diff", "--no-textconv", "--no-color", "--stat", f"{base_sha}..{candidate_sha}",
            attr_source=base_sha,
        ),
        cwd=worktree,
        check=True,
        env_role="orchestrator",
    ).stdout.strip()

    std_rubric = PRELOADED_REFS["standards"]
    spec_rubric = PRELOADED_REFS["spec"]
    prior_std = (prior_findings or {}).get("standards", [])
    prior_spec = (prior_findings or {}).get("spec", [])

    std_lines = [
        "READ-ONLY CODE REVIEW — AXIS: STANDARDS.",
        "Do NOT create, edit, delete, or commit any files, do NOT run tests that write files, and do NOT spawn subagents.",
        "",
        f"Read the complete pre-generated candidate diff at `{diff_patch_path}` (commit range `{base_sha}..{candidate_sha}`).",
        f"Commits:\n{commits or '(none)'}",
        f"Diff stat:\n{diff_stat or '(empty)'}",
        f"Immutable baseline standard snapshots live under `{baseline_std_dir}`: {', '.join(sorted(baseline_std_hashes)) or '(none)'}",
        "",
        std_rubric.strip(),
    ]
    if prior_std:
        std_lines += ["", "## Prior Round Findings (verify resolution first)", *[f"- {x}" for x in prior_std]]
    std_lines += ["", 'Set `axis` to `"standards"`. Return ONLY valid JSON matching the schema.']

    spec_lines = [
        "READ-ONLY CODE REVIEW — AXIS: SPEC & INTEGRITY.",
        "Do NOT create, edit, delete, or commit any files, do NOT run tests that write files, and do NOT spawn subagents.",
        "",
        f"Read the complete pre-generated candidate diff at `{diff_patch_path}` (commit range `{base_sha}..{candidate_sha}`).",
        f"Commits:\n{commits or '(none)'}",
        f"Diff stat:\n{diff_stat or '(empty)'}",
        f"Immutable authoritative Ticket Brief path: `{auth_brief_path}` (read ONLY this path, not any file inside `.dispatch/`).",
        "",
        spec_rubric.strip(),
    ]
    if pr_feedback:
        spec_lines += ["", "## Open PR Review Feedback (verify addressed)", pr_feedback.strip()]
    if prior_spec:
        spec_lines += ["", "## Prior Round Findings (verify resolution first)", *[f"- {x}" for x in prior_spec]]
    spec_lines += ["", 'Set `axis` to `"spec"`. Return ONLY valid JSON matching the schema.']

    std_attach = [diff_patch_path, *(baseline_std_dir / rel for rel in sorted(baseline_std_hashes))]
    spec_attach = [diff_patch_path, *([auth_brief_path] if auth_brief_path else [])]

    def _run_axis(axis: str, prompt_text: str, axis_attach: list[Path]) -> dict[str, Any]:
        last_err: Exception | None = None
        for axis_try in (1, 2):
            _check_shutdown()
            for path in axis_attach:
                assert_sha256_intact(path, artifact_hashes[path], path.name)
            suffix = "" if axis_try == 1 else f"-retry{axis_try}"
            log(f"Running {axis} review via {reviewer.label} (attempt {round_num}{suffix})...")
            try:
                return invoke_harness(
                    reviewer,
                    prompt_text,
                    worktree=worktree,
                    run_dir=run_dir,
                    schema=REVIEW_SCHEMA,
                    schema_file=run_dir / f"review-{axis}-schema.json",
                    prompt_file=run_dir / f"prompt-{axis}-r{round_num}{suffix}.md",
                    out_file=run_dir / f"review-{axis}-r{round_num}{suffix}.json",
                    read_only=True,
                    expected_axis=axis,
                    session_label=f"review-{axis}-r{round_num}{suffix}",
                    trace_sink=trace_sink,
                    attach_files=axis_attach,
                    timeout=review_timeout,
                )
            except (ValueError, subprocess.TimeoutExpired, RuntimeError) as exc:
                last_err = exc
                if axis_try == 1 and not _is_shutdown_requested():
                    log(f"{axis} review failed transiently ({type(exc).__name__}: {exc}); retrying once...")
                    retry_delay = float(os.environ.get("AGENT_DISPATCH_REVIEW_RETRY_SLEEP", "2.0"))
                    if retry_delay > 0:
                        _interruptible_sleep(retry_delay)
                    continue
                raise
        assert last_err is not None
        raise last_err

    pre_review_untracked: dict[str, tuple[int, int, int, int]] = {}
    if setup_files:
        cur_untracked = _untracked_files(worktree)
        unexpected = cur_untracked - set(setup_files)
        if unexpected:
            raise RuntimeError(f"Unexpected untracked files present before review: {sorted(unexpected)[:5]}")
        pre_review_untracked = {name: _file_identity(worktree / name) for name in cur_untracked}

    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
        f_std = pool.submit(_run_axis, "standards", redact_secrets("\n".join(std_lines) + "\n"), std_attach)
        f_spec = pool.submit(_run_axis, "spec", redact_secrets("\n".join(spec_lines) + "\n"), spec_attach) if auth_brief_path else None
        standards_res = f_std.result()
        spec_res = (
            f_spec.result()
            if f_spec
            else {
                "axis": "spec",
                "verdict": "skipped",
                "hard_findings": [],
                "suggestions": ["No Linear issue supplied; Spec axis was NOT executed."],
                "test_integrity_violation": False,
                "summary": "Spec axis skipped (no --issue supplied).",
            }
        )

    # Post-review immutability checks on worktree AND ALL orchestrator-owned artifacts (SHA-256 verified!)
    head_after = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=worktree, check=True, env_role="orchestrator").stdout.strip()
    if setup_files:
        dirty_after = run_cmd(git_cmd("status", "--porcelain", "--untracked-files=no"), cwd=worktree,
                              check=True, env_role="orchestrator").stdout.strip()
        post_untracked = _untracked_files(worktree)
        if post_untracked != set(pre_review_untracked) or any(
            not os.path.lexists(worktree / name) or _file_identity(worktree / name) != original
            for name, original in pre_review_untracked.items()
        ):
            dirty_after += " untracked files changed during review"
    else:
        dirty_after = run_cmd(git_cmd("status", "--porcelain"), cwd=worktree, check=True, env_role="orchestrator").stdout.strip()
    if head_after != candidate_sha or dirty_after:
        raise RuntimeError(
            f"Reviewer mutated worktree! expected HEAD={candidate_sha}, got {head_after}; dirty={dirty_after!r}"
        )
    for path, digest in artifact_hashes.items():
        assert_sha256_intact(path, digest, path.name)

    spec_ok = (spec_res["verdict"] == "pass") if auth_brief_path else True
    passed = (
        standards_res["verdict"] == "pass"
        and spec_ok
        and not standards_res["test_integrity_violation"]
        and not spec_res["test_integrity_violation"]
        and not standards_res["hard_findings"]
        and not spec_res["hard_findings"]
    )
    return {
        "passed": passed,
        "mode": "two_axis" if auth_brief_path else "standards_only",
        "diff_redacted_for_review": diff_redacted_for_review,
        "standards": standards_res,
        "spec": spec_res,
    }


# ---------------------------------------------------------------------------
# Option B Delivery (True Remote Reconciliation, Atomic Checkpoints, Redacted)
# ---------------------------------------------------------------------------

def format_review_markdown(review: dict[str, Any]) -> str:
    def _fmt(title: str, data: dict[str, Any]) -> list[str]:
        lines = [f"### {title} (`{str(data.get('verdict', 'unknown')).upper()}`)"]
        lines.append(redact_secrets(str(data.get("summary", ""))))
        lines.append("")
        lines.append("**Hard Findings:**")
        hard = data.get("hard_findings") or []
        lines.extend([f"- [HARD] {redact_secrets(x)}" for x in hard] or ["- None"])
        lines.append("")
        lines.append("**Suggestions:**")
        sugg = data.get("suggestions") or []
        lines.extend([f"- [Note] {redact_secrets(x)}" for x in sugg] or ["- None"])
        return lines

    return "\n".join(_fmt("Standards Axis", review["standards"]) + [""] + _fmt("Spec & Integrity Axis", review["spec"]))


def build_pr_body(
    issue: dict[str, Any],
    candidate_sha: str,
    worker: HarnessSpec,
    reviewer: HarnessSpec,
    worker_summary: str,
    tests_run: list[str],
    verify_res: dict[str, Any],
    review_res: dict[str, Any],
    discovered_issues: list[str],
    *,
    gate_authorizations: dict[str, Any] | None = None,
) -> str:
    verify_cmd_safe = redact_secrets(str(verify_res.get("command") or ""))
    verify_line = f"`{verify_cmd_safe}` -> **PASS**" if verify_res.get("ran") else "Bypassed (`--allow-no-verify`)"
    tests_safe = ", ".join(redact_secrets(t) for t in tests_run) or "N/A"
    auth_lines: list[str] = []
    if gate_authorizations:
        if gate_authorizations.get("cli_allow_gate_edits"):
            auth_lines.append("- CLI override: `--allow-gate-edits` (all protected gate paths)")
        if gate_authorizations.get("cli_allow_test_edits"):
            auth_lines.append("- CLI override: `--allow-test-edits` (all test-integrity checks)")
        if gate_authorizations.get("brief_gate_patterns"):
            auth_lines.append(f"- Brief-authorized gate paths: {', '.join(f'`{p}`' for p in gate_authorizations['brief_gate_patterns'])}")
        if gate_authorizations.get("brief_test_patterns"):
            auth_lines.append(f"- Brief-authorized test paths: {', '.join(f'`{p}`' for p in gate_authorizations['brief_test_patterns'])}")
    lines = [
        "## Linear Issue",
        f"- [{issue['identifier']}: {issue['title']}]({issue.get('url', '')})",
        "",
        "## Implementation Summary",
        f"- **Candidate SHA**: `{candidate_sha}`",
        f"- **Worker**: `{worker.label}`",
        f"- **Reviewer**: `{reviewer.label}`",
        f"- **Summary**: {redact_secrets(worker_summary)}",
        "",
        "## Verification",
        f"- {verify_line}",
        f"- Worker tests run: {tests_safe}",
    ]
    if auth_lines:
        lines += ["", "## Active Gate/Test Authorizations", *auth_lines]
    lines += [
        "",
        "## Two-Axis Code Review (Unmerged)",
        format_review_markdown(review_res),
        "",
        "## Side Issues Discovered (Untouched)",
    ]
    lines.extend([f"- {redact_secrets(d)}" for d in discovered_issues] or ["- None"])
    return redact_secrets("\n".join(lines) + "\n")


PR_FIELDS = "url,number,state,isDraft,headRefOid,headRefName,baseRefName,isCrossRepository"


def fetch_open_prs_for_branch(worktree: Path, gh_repo: str | None, branch: str, *, state: str = "open") -> list[dict[str, Any]]:
    cmd = ["gh", "pr", "list", "--head", branch, "--state", state, "--limit", "100", "--json", PR_FIELDS]
    if gh_repo:
        cmd += ["--repo", gh_repo]
    res = run_cmd(cmd, cwd=worktree, env_role="orchestrator", check=True, cap_output=False)
    prs = json.loads(res.stdout)
    if not isinstance(prs, list) or len(prs) >= 100:
        raise RuntimeError(f"Incomplete GitHub PR lookup for {branch}.")
    return [pr for pr in prs if pr["isCrossRepository"] is False and pr["headRefName"] == branch]


def fetch_open_pr_for_branch(worktree: Path, gh_repo: str | None, branch: str) -> dict[str, Any] | None:
    prs = fetch_open_prs_for_branch(worktree, gh_repo, branch)
    if len(prs) > 1:
        nums = [p.get("number") for p in prs]
        raise RuntimeError(
            f"Multiple open PRs share head branch '{branch}' (#{nums}); refusing ambiguous push/update."
        )
    return prs[0] if prs else None


def fetch_open_pr_feedback(worktree: Path, gh_repo: str | None, pr_number: int) -> str | None:
    """Fetch PR comments, reviews, and paginated inline review threads ONLY from explicitly trusted authors."""
    cmd = ["gh", "pr", "view", str(pr_number), "--json", "comments,reviews"]
    if gh_repo:
        cmd += ["--repo", gh_repo]
    res = run_cmd(cmd, cwd=worktree, env_role="orchestrator")
    if res.returncode != 0:
        raise RuntimeError(f"gh pr view failed ({res.returncode}): {redact_secrets(res.stderr)}")
    data = json.loads(res.stdout or "{}")
    notes: list[str] = []
    for r in data.get("reviews") or []:
        assoc = (r.get("authorAssociation") or "").upper()
        if assoc not in TRUSTED_PR_AUTHOR_ASSOCIATIONS:
            continue
        body = (r.get("body") or "").strip()
        if body and r.get("state") in ("CHANGES_REQUESTED", "COMMENTED"):
            author = (r.get("author") or {}).get("login", "reviewer")
            notes.append(f"- [PR Review by @{author} ({r.get('state')})]: {redact_secrets(body)}")
    for c in data.get("comments") or []:
        assoc = (c.get("authorAssociation") or "").upper()
        if assoc not in TRUSTED_PR_AUTHOR_ASSOCIATIONS:
            continue
        body = (c.get("body") or "").strip()
        if body and "[agent-dispatch]" not in body:
            author = (c.get("author") or {}).get("login", "user")
            notes.append(f"- [PR Comment by @{author}]: {redact_secrets(body)}")

    # Paginated inline code review comments via REST API
    if gh_repo:
        inline = run_cmd(
            ["gh", "api", "--paginate", "--slurp", f"repos/{gh_repo}/pulls/{pr_number}/comments"],
            cwd=worktree,
            env_role="orchestrator",
            cap_output=False,
        )
        if inline.returncode != 0:
            log(f"Warning: failed fetching inline PR comments for #{pr_number}: {redact_secrets(inline.stderr)[:300]}")
        elif inline.stdout.strip():
            try:
                parsed = json.loads(inline.stdout)
                # --slurp produces list of pages (list[list[dict]]) or list[dict]
                items: list[dict[str, Any]] = []
                if isinstance(parsed, list):
                    for elem in parsed:
                        if isinstance(elem, list):
                            items.extend(x for x in elem if isinstance(x, dict))
                        elif isinstance(elem, dict):
                            items.append(elem)
                for ic in items:
                    assoc = (ic.get("author_association") or "").upper()
                    if assoc not in TRUSTED_PR_AUTHOR_ASSOCIATIONS:
                        continue
                    body = (ic.get("body") or "").strip()
                    if body:
                        author = (ic.get("user") or {}).get("login", "reviewer")
                        path = ic.get("path", "")
                        line = ic.get("line") or ic.get("original_line") or ""
                        notes.append(f"- [Inline PR Comment by @{author} on `{path}:{line}`]: {redact_secrets(body)}")
            except json.JSONDecodeError as exc:
                log(f"Warning: could not parse inline PR comments JSON for #{pr_number}: {exc}")
    return redact_secrets("\n".join(notes)) if notes else None


PUBLISH_STAGES = ("verified_and_reviewed", "pushing", "pushed", "pr_ready", "linear_state_synced")
COMPLETED_STAGES = ("completed", "completed_branch_only")


def save_checkpoint(run_dir: Path, latest_file: Path, state: dict[str, Any]) -> None:
    state["updated_at"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    payload = safe_json(state, indent=2, ensure_ascii=False)
    atomic_write_text(run_dir / "state.json", payload)
    atomic_write_text(latest_file, safe_json({"run_dir": str(run_dir), **state}, indent=2, ensure_ascii=False))


def _validate_open_draft_pr(pr: dict[str, Any] | None, *, base_branch: str, candidate_sha: str | None = None, context: str = "") -> dict[str, Any]:
    if not pr:
        raise RuntimeError(f"Expected open Draft PR ({context}), but GitHub returned no open PR.")
    if pr.get("state") != "OPEN":
        raise RuntimeError(f"PR #{pr.get('number')} is {pr.get('state')!r} (human action preserved).")
    if pr.get("isDraft") is not True:
        raise RuntimeError(f"Open PR #{pr.get('number')} ({context}) is not a Draft PR; refusing to overwrite.")
    if pr.get("baseRefName") != base_branch:
        raise RuntimeError(
            f"Open PR #{pr.get('number')} ({context}) targets '{pr.get('baseRefName')}', expected '{base_branch}'."
        )
    if candidate_sha is not None and pr.get("headRefOid") != candidate_sha:
        raise RuntimeError(
            f"Open PR #{pr.get('number')} ({context}) headRefOid ({str(pr.get('headRefOid') or 'missing')[:8]}) != reviewed SHA ({candidate_sha[:8]})."
        )
    return pr


def _claim_metadata_matches(issue: dict[str, Any], state: dict[str, Any]) -> bool:
    expected = state.get("claimed_ownership") or {}
    return (
        ("assignee_id" not in expected or (issue.get("assignee") or {}).get("id", "") == expected["assignee_id"])
        and (not expected.get("description_sha") or sha256_text(issue.get("description") or "") == expected["description_sha"])
    )


def _require_publish_ownership(issue: dict[str, Any], state: dict[str, Any]) -> None:
    live = issue["state"]
    claimed = state.get("claimed_state_id")
    in_claim = live.get("id") == claimed if claimed else live.get("name", "").lower() == "in progress"
    in_review = live.get("name", "").lower() == "in review"
    stage = state.get("stage")
    if (live.get("type") in ("completed", "canceled") or not _claim_metadata_matches(issue, state)
            or not (in_review if stage == "linear_state_synced" else in_claim or (stage == "pr_ready" and in_review))):
        raise RuntimeError(f"Human Linear ownership conflict on {issue['identifier']} at {stage}: state {live.get('name')!r}.")


def reconcile_publish(
    client: LinearClient,
    issue: dict[str, Any],
    repo_root: Path,
    run_dir: Path,
    latest_file: Path,
    state: dict[str, Any],
    *,
    allow_branch_only: bool = False,
) -> dict[str, Any]:
    """
    Stage-aware, non-destructive remote reconciliation:
      - Respects already-completed stages (`pr_ready`, `linear_state_synced`) so resuming after a late comment failure
        NEVER recreates a human-closed PR, NEVER overwrites a human-edited PR body, and NEVER reverts human state edits.
      - Fails closed on unrecognized non-local remotes (unless `allow_branch_only=True`) and on >1 open PR sharing head branch.
      - Checks live Linear ownership/terminal state and PR compatibility BEFORE any remote push.
    """
    branch = state["branch"]
    base_branch = state["base_branch"]
    candidate_sha = state["candidate_sha"]
    remote_kind, gh_repo, raw_remote_url = classify_origin_remote(repo_root)
    if remote_kind == "none":
        raise RuntimeError("Publishing requires an origin remote.")
    expected_destination = state.get("publish_destination")
    if expected_destination:
        if sha256_text(gh_repo.lower() if gh_repo else raw_remote_url) != expected_destination:
            raise RuntimeError("Origin destination changed since preflight; refusing to publish.")
    elif not gh_repo or state.get("repo_identity") != canonical_repo_identity(repo_root):
        # Older checkpoints bound GitHub runs to owner/repo. For other remotes they bound only the local clone.
        raise RuntimeError("Legacy checkpoint cannot verify the publish destination. Review the configured origin and rerun.")
    force_gh = os.environ.get("AGENT_DISPATCH_FORCE_GH") == "1"
    if remote_kind == "github" or force_gh:
        is_github = True
    elif remote_kind in ("local_path", "none") or allow_branch_only:
        is_github = False
    else:
        raise RuntimeError(
            "Unrecognized non-GitHub origin remote; refusing silent branch-only delivery "
            f"(configure a standard GitHub origin URL or pass --allow-branch-only explicitly)."
        )

    cur_stage = str(state.get("stage") or "verified_and_reviewed")
    recorded_pr_num = state.get("pr_number")

    live_pre = client.get_issue(issue["identifier"])
    _require_publish_ownership(live_pre, state)

    pr_title = f"{issue['identifier']}: {issue['title']}"
    title_secrets = scan_text_for_secrets(pr_title, "PR title", allow_marker=False)
    if title_secrets:
        raise RuntimeError("Refusing to publish PR with secret in title: " + "; ".join(title_secrets))

    # Recheck PR identity even on a late resume. A different open PR cannot replace the recorded one.
    existing = None
    if is_github:
        existing = fetch_open_pr_for_branch(repo_root, gh_repo, branch)
        if recorded_pr_num and (not existing or existing["number"] != recorded_pr_num):
            raise RuntimeError(f"Recorded PR #{recorded_pr_num} is no longer the open PR (human action preserved).")
        if existing:
            _validate_open_draft_pr(existing, base_branch=base_branch, context="pre-push check")
            state["pr_number"] = existing["number"]
        elif cur_stage in ("pr_ready", "linear_state_synced"):
            raise RuntimeError("Previously delivered PR is no longer open (human action preserved).")
        elif cur_stage == "pushed" or state.get("pr_create_attempted"):
            history = fetch_open_prs_for_branch(repo_root, gh_repo, branch, state="all")
            if any(pr.get("headRefOid") == candidate_sha for pr in history):
                raise RuntimeError("Previously delivered PR is no longer open (human action preserved).")

    remote_sha = get_remote_branch_sha(repo_root, branch)
    already_pushed = cur_stage in ("pushed", "pr_ready", "linear_state_synced") or state.get("pushed")
    # Older checkpoints recorded only the merge base used for review.
    expected_base = state.get("target_sha") or state.get("base_sha")
    if not expected_base:
        raise RuntimeError("Publish checkpoint is missing the reviewed base commit.")
    check_remote_base(repo_root, base_branch, expected_base, "publication")
    if remote_sha != candidate_sha and already_pushed:
        raise RuntimeError(f"Remote origin/{branch} moved or was deleted after push; human action preserved.")
    if remote_sha != candidate_sha:
        if "pre_push_sha" in state and remote_sha != state["pre_push_sha"]:
            raise RuntimeError(f"Remote origin/{branch} changed after review; refusing to push.")
        if remote_sha:
            run_cmd(git_cmd("fetch", "origin", f"refs/heads/{branch}"), cwd=repo_root, check=True, env_role="orchestrator")
            anc = run_cmd(git_cmd("merge-base", "--is-ancestor", remote_sha, candidate_sha), cwd=repo_root, env_role="orchestrator")
            if anc.returncode != 0:
                raise RuntimeError(f"Remote origin/{branch} diverged from reviewed SHA; refusing to push.")
        state.update(push_attempted=True, stage="pushing", pre_push_sha=remote_sha)
        save_checkpoint(run_dir, latest_file, state)
        _check_shutdown()
        # The lease closes the race with a human resetting/deleting the branch after the ancestry check.
        ref = f"refs/heads/{branch}"
        run_cmd(git_cmd("push", "--no-verify", f"--force-with-lease={ref}:{remote_sha}", "origin", f"{candidate_sha}:{ref}"),
                cwd=repo_root, check=True, env_role="orchestrator")
        if get_remote_branch_sha(repo_root, branch) != candidate_sha:
            raise RuntimeError("Remote SHA mismatch after push.")

    if cur_stage not in ("pr_ready", "linear_state_synced"):
        state.update(pushed=True, push_attempted=True, stage="pushed")
        save_checkpoint(run_dir, latest_file, state)
        if is_github:
            if not existing:
                state["pr_create_attempted"] = True
                save_checkpoint(run_dir, latest_file, state)
                body_file = run_dir / "pr-body.md"
                atomic_write_text(body_file, redact_secrets(state["pr_body"]))
                cmd = ["gh", "pr", "create", "--draft", "--base", base_branch, "--head", branch,
                       "--title", pr_title, "--body-file", str(body_file)]
                if gh_repo:
                    cmd += ["--repo", gh_repo]
                created = run_cmd(cmd, cwd=repo_root, check=True, env_role="orchestrator")
                number = re.search(r"/pull/(\d+)/?$", created.stdout.strip())
                if number:
                    state["pr_number"] = int(number.group(1))
                    save_checkpoint(run_dir, latest_file, state)

            attempts = max(1, int(os.environ.get("AGENT_DISPATCH_PR_POLL_ATTEMPTS", "5")))
            pause = float(os.environ.get("AGENT_DISPATCH_PR_POLL_SLEEP", "2.0"))
            for attempt_i in range(attempts):
                _check_shutdown()
                pr = fetch_open_pr_for_branch(repo_root, gh_repo, branch)
                if pr and pr.get("headRefOid") == candidate_sha:
                    break
                if attempt_i + 1 < attempts:
                    _interruptible_sleep(pause)
            verified = _validate_open_draft_pr(pr, base_branch=base_branch, candidate_sha=candidate_sha, context="PR read-back")
            if state.get("pr_number") and verified["number"] != state["pr_number"]:
                raise RuntimeError("Open PR changed during publication; human action preserved.")
            state.update(pr_number=verified["number"], pr_url=verified["url"], delivery_mode="draft_pr")
        else:
            state.update(pr_url="", delivery_mode="branch_only")
        state["stage"] = "pr_ready"
        save_checkpoint(run_dir, latest_file, state)
    elif is_github:
        _validate_open_draft_pr(existing, base_branch=base_branch, candidate_sha=candidate_sha, context=cur_stage)

    live_issue = client.get_issue(issue["id"])
    _require_publish_ownership(live_issue, state)
    _check_shutdown()
    if state["stage"] != "linear_state_synced":
        client.update_issue_state(live_issue, "In Review")
        state.update(linear_state_synced=True, stage="linear_state_synced")
        save_checkpoint(run_dir, latest_file, state)
    client.remove_labels_if_present(live_issue, {"dispatch:failed", "dispatch:publish-incomplete"})
    issue["state"] = live_issue["state"]
    issue["labels"] = live_issue["labels"]

    # 4. Idempotent delivery summary comment keyed by stable marker
    marker = f"<!-- agent-dispatch-delivery:{state['run_id']}:{candidate_sha} -->"
    existing_comments = (live_issue.get("comments") or {}).get("nodes", [])
    already_posted = any(marker in (c.get("body") or "") for c in existing_comments)
    if not already_posted:
        rev = state["review"]
        pr_line = state["pr_url"] if state.get("pr_url") else "N/A (branch-only non-GitHub remote)"
        comment_lines = [
            marker,
            f"### [agent-dispatch] Ready for Human Merge (`{candidate_sha[:8]}`)",
            f"- **Draft PR**: {pr_line}",
            f"- **Branch**: `{branch}` (`{candidate_sha}`)",
            f"- **Worker / Reviewer**: `{state['worker']}` / `{state['reviewer']}`",
            f"- **Attempts**: {state['attempt']}/{state['max_attempts']}",
            f"- **Summary**: {redact_secrets(state['worker_summary'])}",
            f"- **Standards**: `{rev['standards']['verdict'].upper()}` — {redact_secrets(rev['standards']['summary'])}",
            f"- **Spec**: `{rev['spec']['verdict'].upper()}` — {redact_secrets(rev['spec']['summary'])}",
        ]
        auth_meta = state.get("gate_authorizations") or {}
        if any(auth_meta.values()):
            comment_lines.append(f"- **Gate/Test Authorizations**: `{json.dumps(auth_meta, ensure_ascii=False)}`")
        if state.get("discovered_issues"):
            comment_lines += ["", "**Discovered Side Issues (untouched):**"]
            comment_lines.extend(f"- {redact_secrets(d)}" for d in state["discovered_issues"])
        client.add_comment(live_issue["id"], "\n".join(comment_lines))
    state["linear_comment_posted"] = True
    state["stage"] = "completed" if state.get("delivery_mode") == "draft_pr" else "completed_branch_only"
    save_checkpoint(run_dir, latest_file, state)
    return state


def verify_completed_publish_readonly(
    client: LinearClient,
    live_issue: dict[str, Any],
    repo_root: Path,
    state: dict[str, Any],
) -> dict[str, Any]:
    """Read-only verification for already-completed checkpoints: checks SHA, PR state/draft/base/head, AND Linear state."""
    branch = state["branch"]
    base_branch = state["base_branch"]
    candidate_sha = state["candidate_sha"]
    _, gh_repo, raw_remote_url = classify_origin_remote(repo_root)
    if state.get("publish_destination") and sha256_text(gh_repo.lower() if gh_repo else raw_remote_url) != state["publish_destination"]:
        raise RuntimeError("Origin destination changed since publication.")
    is_github = bool(gh_repo or os.environ.get("AGENT_DISPATCH_FORCE_GH") == "1")
    conflicts: list[str] = []

    remote_sha = get_remote_branch_sha(repo_root, branch)
    if remote_sha != candidate_sha:
        conflicts.append(f"Remote origin/{branch} SHA is '{remote_sha[:8] or 'deleted'}', expected '{candidate_sha[:8]}'.")

    live_st_name = str((live_issue.get("state") or {}).get("name") or "")
    if live_st_name.lower() != "in review":
        conflicts.append(f"Linear issue state drifted to '{live_st_name}' (expected 'In Review'; human action preserved).")

    if is_github and state.get("delivery_mode", "draft_pr") == "draft_pr":
        pr_num = state.get("pr_number")
        pr_obj = fetch_open_pr_for_branch(repo_root, gh_repo, branch)
        if not pr_obj or (pr_num and pr_obj["number"] != pr_num):
            conflicts.append(f"Delivered PR ({state.get('pr_url') or branch}) is no longer the open PR (human action preserved).")
        else:
            pr_state = str(pr_obj.get("state") or "OPEN").upper()
            if pr_state != "OPEN":
                conflicts.append(f"Delivered PR #{pr_obj.get('number')} is '{pr_state}' (human action preserved; refusing to reopen/recreate).")
            elif pr_obj.get("baseRefName") != base_branch:
                conflicts.append(f"Delivered PR #{pr_obj.get('number')} base changed to '{pr_obj.get('baseRefName')}' (expected '{base_branch}').")
            elif pr_obj.get("headRefOid") != candidate_sha:
                conflicts.append(f"Delivered PR #{pr_obj.get('number')} headRefOid is '{str(pr_obj.get('headRefOid') or '')[:8]}', expected '{candidate_sha[:8]}'.")
            elif pr_obj.get("isDraft") is not True:
                conflicts.append(f"Delivered PR #{pr_obj.get('number')} was marked Ready for Review by a human (preserving without overwrite).")

    if conflicts:
        raise RuntimeError(
            "Checkpoint is already completed, and remote state diverged (likely human action); refusing to overwrite:\n"
            + "\n".join(f"- {c}" for c in conflicts)
        )
    return {
        "issue": live_issue["identifier"],
        "status": "passed_branch_only" if state["stage"] == "completed_branch_only" else "passed",
        "reconciled": False,
        "verified_readonly": True,
        "commit": candidate_sha,
        "pr_url": state.get("pr_url", ""),
        "linear_state": live_st_name,
        "run_dir": state.get("run_dir", ""),
        "sessions": state.get("sessions", []),
    }


# ---------------------------------------------------------------------------
# Core Ticket Pipeline
# ---------------------------------------------------------------------------

def _assert_no_external_tampering(
    client: LinearClient,
    repo_root: Path,
    worktree: Path,
    branch: str,
    base_branch: str,
    issue_uuid: str,
    expected_branch_sha: str,
    expected_base_sha: str,
    expected_git_cfg: dict[str, str],
    expected_ownership: dict[str, str],
    phase: str,
    *,
    allow_gitattributes_edit: bool = False,
) -> None:
    """
    Parallel-safe external tampering check:
      - Checks ONLY this ticket's remote branch SHA (never fails when a parallel brother ticket pushes feat/<other>!)
      - Checks monotonic ancestry of origin/<base_branch> (normal merges/pushes to main are allowed; force-push/deletion fails!)
      - Checks local git config SHA-256 unchanged (always) and root .gitattributes unchanged (unless explicitly authorized)
      - Checks Linear ownership fields (state, assignee, description hash)
    """
    if expected_git_cfg:
        cur_cfg = snapshot_local_git_config(worktree)
        if cur_cfg["local_config_sha"] != expected_git_cfg.get("local_config_sha"):
            raise RuntimeError(f"Unauthorized git config tampering detected during {phase} (.git/config modified).")
        if not allow_gitattributes_edit and cur_cfg["gitattributes_sha"] != expected_git_cfg.get("gitattributes_sha"):
            raise RuntimeError(f"Unauthorized .gitattributes tampering detected during {phase}.")
    cur_branch_sha = get_remote_branch_sha(repo_root, branch)
    if cur_branch_sha != expected_branch_sha:
        raise RuntimeError(
            f"Unauthorized external mutation during {phase}: origin/{branch} changed "
            f"from {expected_branch_sha[:8] or 'none'} to {cur_branch_sha[:8] or 'none'}."
        )
    check_remote_base(repo_root, base_branch, expected_base_sha, phase)
    if expected_ownership:
        cur = client.get_issue_ownership_snapshot(issue_uuid)
        if cur.get("state_type") in ("completed", "canceled"):
            raise RuntimeError(
                f"Human terminal state conflict during {phase}: Linear issue was moved to '{cur.get('state_name')}'."
            )
        if expected_ownership.get("state_id") and cur.get("state_id") != expected_ownership.get("state_id"):
            raise RuntimeError(
                f"External Linear state mutation during {phase}: state changed from "
                f"'{expected_ownership.get('state_name')}' to '{cur.get('state_name')}'."
            )
        if cur.get("assignee_id") != expected_ownership.get("assignee_id"):
            raise RuntimeError(f"External Linear assignee mutation during {phase}: assignee changed mid-run.")
        if expected_ownership.get("description_sha") and cur.get("description_sha") != expected_ownership.get("description_sha"):
            raise RuntimeError(f"External Linear description mutation during {phase}: acceptance criteria changed mid-run.")
        if expected_ownership.get("updated_at") and cur.get("updated_at") and cur.get("updated_at") != expected_ownership.get("updated_at"):
            log(f"Note: benign Linear metadata update detected during {phase} (state/assignee/description unchanged).")


def _stash_dirty_worktree_for_safe_rerun(worktree: Path, label: str, *, attr_source: str | None = None) -> None:
    """Stash safe edits, leaving potentially sensitive working files and index entries untouched."""
    try:
        ensure_dispatch_excluded(worktree, ignore_shutdown=True)
        dirty = run_cmd(git_cmd("status", "--porcelain"), cwd=worktree, check=True, env_role="orchestrator", ignore_shutdown=True).stdout.strip()
        if dirty:
            if _scan_before_git_write(worktree, for_stash=True, attr_source=attr_source):
                log("Secret scan blocked automatic stash. Working files and index were preserved for manual inspection.")
                return
            run_cmd(
                git_cmd("stash", "push", "-u", "-m", f"agent-dispatch-{label}"),
                cwd=worktree,
                check=True,
                env_role="orchestrator",
                ignore_shutdown=True,
            )
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
        log(f"Could not safely stash working files: {redact_secrets(str(exc))}")


def execute_ticket(
    client: LinearClient,
    repo_root: Path,
    repo_project: dict[str, Any] | None,
    identifier: str,
    worker: HarnessSpec,
    reviewer: HarnessSpec,
    *,
    verify_cmd_override: str | None,
    setup_cmd_override: str | None,
    max_rework: int,
    verify_timeout: int,
    setup_timeout: int,
    worker_timeout: int = 1800,
    review_timeout: int = 900,
    no_push: bool,
    allow_no_verify: bool,
    allow_gate_edits: bool,
    allow_test_edits: bool,
    allow_dirty_docs: bool,
    allow_branch_only: bool = False,
    skip_baseline: bool,
    skip_project_check: bool,
    force_rerun: bool,
    fresh: bool,
    auto_claimed: bool = False,
    reserved_touches: set[str] | None = None,
) -> dict[str, Any]:
    if max_rework < 0 or max_rework > 5:
        raise ValueError("--max-rework must be between 0 and 5")
    assert_required_rubrics_loaded()
    _check_shutdown()

    rkey = repo_cache_key(repo_root)
    repo_common = get_git_common_dir(repo_root)
    base_branch = detect_default_branch(repo_root)

    publish_destination = ""
    if not no_push:
        remote_kind, remote_repo, raw_remote_url = classify_origin_remote(repo_root)
        if remote_kind == "none":
            raise RuntimeError("Publishing requires an origin remote. Configure origin or use --no-push.")
        publish_destination = sha256_text(remote_repo.lower() if remote_repo else raw_remote_url)
        if remote_kind == "unknown_remote" and not allow_branch_only and os.environ.get("AGENT_DISPATCH_FORCE_GH") != "1":
            raise RuntimeError(
                "Unrecognized non-GitHub origin remote; refusing silent branch-only delivery "
                f"(configure a standard GitHub URL or pass --allow-branch-only)."
            )

    if not allow_dirty_docs:
        dirty_doc_msgs = check_dirty_docs_in_main_repo(repo_root, base_branch)
        if dirty_doc_msgs:
            raise RuntimeError(
                "Main repo has uncommitted/unpushed domain docs; land them on base branch first (or pass --allow-dirty-docs):\n"
                + "\n".join(dirty_doc_msgs)
            )

    # Fetch issue first to resolve canonical UUID for cross-clone ticket lock
    issue = client.get_issue(identifier)
    t_lock = ticket_lock_path(repo_root, issue["id"])

    def _validate_claim_eligibility(iss_obj: dict[str, Any]) -> dict[str, Any] | None:
        if not skip_project_check and repo_project:
            iss_proj = iss_obj.get("project") or {}
            if iss_proj.get("id") != repo_project["id"]:
                raise RuntimeError(
                    f"Cross-repo guard: {iss_obj['identifier']} belongs to Linear project "
                    f"'{iss_proj.get('name', 'None')}', but current repo maps to '{repo_project['name']}'."
                )
        label_names_l = {l["name"].lower() for l in (iss_obj.get("labels") or {}).get("nodes", [])}
        if (iss_obj.get("children") or {}).get("nodes") or "spec" in label_names_l:
            raise RuntimeError(
                f"{iss_obj['identifier']} is a Spec/parent container (not a leaf slice); use `spec {iss_obj['identifier']}`."
            )
        st_type = (iss_obj.get("state") or {}).get("type", "")
        if st_type in ("completed", "canceled"):
            raise RuntimeError(f"{iss_obj['identifier']} is already {iss_obj['state']['name']}; refusing to run.")
        if auto_claimed:
            if reserved_touches is not None and reserved_touches != parse_touches(iss_obj.get("description") or ""):
                return {"issue": iss_obj["identifier"], "status": "deferred", "reason": "touches_changed_before_claim"}
            ready_ok, ready_reason = is_ready_for_frontier(iss_obj)
            if not ready_ok:
                return {"issue": iss_obj["identifier"], "status": "skipped_changed_before_claim", "reason": ready_reason}
        elif st_type == "started" and not force_rerun:
            raise RuntimeError(
                f"{iss_obj['identifier']} is already '{iss_obj['state']['name']}'. Pass --force-rerun (or `resume`) to proceed."
            )
        active_blks, canceled_blks = classify_blockers(iss_obj)
        if active_blks or canceled_blks:
            return {
                "issue": iss_obj["identifier"],
                "status": "blocked_by_dependencies",
                "active_blockers": active_blks,
                "canceled_blockers": canceled_blks,
            }
        if not no_push:
            team_state_names = {s["name"].lower() for s in (iss_obj.get("team") or {}).get("states", {}).get("nodes", [])}
            for req_state in ("in progress", "todo", "in review"):
                if req_state not in team_state_names:
                    raise RuntimeError(f"Required Linear workflow state '{req_state}' missing in team {iss_obj['team']['key']}.")
        return None

    with file_lock(t_lock, blocking=False), contextlib.ExitStack() as run_cleanup:
        latest_file = _cache_root() / "runs" / rkey / issue["identifier"] / ("latest-local.json" if no_push else "latest.json")
        if not no_push and not force_rerun and latest_file.is_file():
            try:
                latest = json.loads(latest_file.read_text(encoding="utf-8"))
                if not isinstance(latest, dict) or not latest.get("run_dir"):
                    raise ValueError("missing run_dir")
                authoritative = Path(latest["run_dir"]) / "state.json"
                previous = json.loads(authoritative.read_text(encoding="utf-8")) if authoritative.is_file() else latest
                if not isinstance(previous, dict):
                    raise ValueError("state is not a JSON object")
            except (OSError, ValueError) as exc:
                raise RuntimeError(
                    f"Corrupt checkpoint at {latest_file} ({exc}); inspect manually or pass --force-rerun."
                ) from exc
            if previous.get("stage") in ("claim_pending", "rollback_pending", *PUBLISH_STAGES):
                raise RuntimeError(f"Checkpoint at {previous['stage']}; run agent-dispatch resume {issue['identifier']} first.")
        # 1. Initial eligibility check inside lock
        issue = client.get_issue(issue["id"])
        early_ret = _validate_claim_eligibility(issue)
        if early_ret is not None:
            return early_ret

        # Early metadata secret scan BEFORE writing brief or calling ANY LLM harness!
        early_title_hits = scan_text_for_secrets(str(issue.get("title") or ""), "ticket title", allow_marker=False)
        if early_title_hits:
            return {
                "issue": issue["identifier"],
                "status": "secret_in_metadata",
                "error": "Secret detected in ticket title before dispatch:\n" + "\n".join(f"- {s}" for s in early_title_hits),
                "sessions": [],
            }

        run_id = f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
        run_dir = _cache_root() / "runs" / rkey / issue["identifier"] / run_id
        run_dir.mkdir(parents=True, exist_ok=True)

        # 2. Prepare worktree (writes owner.json INSIDE repo lock!), remote FF, bootstrap, verify detect & base baseline ALL BEFORE claiming Linear!
        worktree, branch, target_sha = prepare_worktree(
            repo_root, issue["identifier"], base_branch, fresh=fresh, issue_uuid=issue["id"]
        )
        base_sha = run_cmd(git_cmd("merge-base", target_sha, "HEAD"), cwd=worktree,
                           check=True, env_role="orchestrator").stdout.strip()
        preflight_pr = None
        pre_branch_sha = ""
        gh_repo = parse_github_owner_repo(repo_root)
        if not no_push:
            pre_branch_sha = check_remote_fast_forward_ready(repo_root, worktree, branch)
            if gh_repo or os.environ.get("AGENT_DISPATCH_FORCE_GH") == "1":
                preflight_pr = fetch_open_pr_for_branch(repo_root, gh_repo, branch)
                if preflight_pr:
                    _validate_open_draft_pr(preflight_pr, base_branch=base_branch, context="preflight PR check")

        before_setup = _untracked_files(worktree)
        bootstrap_worktree(worktree, setup_cmd_override, timeout=setup_timeout)
        setup_files = {name: _file_identity(worktree / name) for name in _untracked_files(worktree) - before_setup}
        if setup_files:
            run_cleanup.callback(_release_setup_files, worktree, setup_files)
        verify_cmd = detect_verify_command(worktree, verify_cmd_override)
        if not verify_cmd and not allow_no_verify:
            return {
                "issue": issue["identifier"],
                "status": "no_verify_command",
                "error": "No deterministic verification command detected (pass --verify-cmd or --allow-no-verify).",
                "run_dir": str(run_dir),
            }

        if not skip_baseline:
            base_check = check_base_baseline(
                repo_root,
                rkey,
                worktree,
                target_sha,
                verify_cmd_override,
                run_dir,
                setup_cmd_override=setup_cmd_override,
                setup_timeout=setup_timeout,
                allow_no_verify=allow_no_verify,
                timeout=verify_timeout,
            )
            if not base_check["passed"]:
                return {
                    "issue": issue["identifier"],
                    "status": "base_branch_red",
                    "base_sha": target_sha,
                    "verify": base_check,
                    "run_dir": str(run_dir),
                }

        # 3. Re-read live Linear issue AFTER expensive preflight so human edits during bootstrap/baseline are respected!
        issue = client.get_issue(issue["id"])
        early_ret2 = _validate_claim_eligibility(issue)
        if early_ret2 is not None:
            return early_ret2
        early_title_hits2 = scan_text_for_secrets(str(issue.get("title") or ""), "ticket title", allow_marker=False)
        if early_title_hits2:
            return {
                "issue": issue["identifier"],
                "status": "secret_in_metadata",
                "error": "Secret detected in ticket title before dispatch:\n" + "\n".join(f"- {s}" for s in early_title_hits2),
                "run_dir": str(run_dir),
                "sessions": [],
            }

        pre_claim_state_id = str((issue.get("state") or {}).get("id") or "")
        pre_claim_state_name = str((issue.get("state") or {}).get("name") or "Todo")
        in_prog_state_id = next(
            (str(s["id"]) for s in (issue.get("team") or {}).get("states", {}).get("nodes", []) if s["name"].lower() == "in progress"),
            "",
        )

        # Authoritative immutable artifacts (SHA-256 verified before and after review)
        auth_brief_content = render_issue_snapshot(issue)
        auth_brief_path = run_dir / "brief.md"
        atomic_write_text(auth_brief_path, auth_brief_content)
        auth_brief_sha256 = sha256_file(auth_brief_path)
        wt_brief_path = worktree / ".dispatch" / f"{issue['identifier']}.md"
        wt_brief_path.parent.mkdir(parents=True, exist_ok=True)
        atomic_write_text(wt_brief_path, auth_brief_content)

        baseline_std_dir = run_dir / "baseline-standards"
        _, baseline_std_hashes = snapshot_baseline_standards(worktree, base_sha, baseline_std_dir)
        worker_artifacts = {baseline_std_dir / rel: digest for rel, digest in baseline_std_hashes.items()}
        standard_paths = list(worker_artifacts)
        worker_artifacts[auth_brief_path] = auth_brief_sha256

        brief_gate_pats, brief_test_pats = parse_authorized_changes(issue.get("description") or "")
        allow_root_gitattributes = allow_gate_edits or path_matches_any_pattern(".gitattributes", brief_gate_pats)
        gate_authorizations = {
            "cli_allow_gate_edits": allow_gate_edits,
            "cli_allow_test_edits": allow_test_edits,
            "brief_gate_patterns": brief_gate_pats,
            "brief_test_patterns": brief_test_pats,
        }

        sessions: list[dict[str, Any]] = []
        state: dict[str, Any] = {
            "issue": issue["identifier"],
            "issue_uuid": issue["id"],
            "run_id": run_id,
            "run_dir": str(run_dir),
            "repo_root": str(repo_root),
            "repo_identity": canonical_repo_identity(repo_root),
            "worktree": str(worktree),
            "branch": branch,
            "base_branch": base_branch,
            "base_sha": base_sha,
            "target_sha": target_sha,
            "worker": worker.label,
            "reviewer": reviewer.label,
            "no_push": no_push,
            "allow_branch_only": allow_branch_only,
            "publish_destination": publish_destination,
            "claimed_state_id": in_prog_state_id,
            "claimed_ownership": {"description_sha": sha256_text(issue.get("description") or ""),
                                  "assignee_id": (issue.get("assignee") or {}).get("id", "")},
            "pre_claim_state_id": pre_claim_state_id,
            "pre_claim_state_name": pre_claim_state_name,
            "gate_authorizations": gate_authorizations,
            "stage": "preflight_ok",
            "push_attempted": False,
            "pushed": False,
        }
        save_checkpoint(run_dir, latest_file, state)

        claim_attempted = False
        moved_in_progress = False
        pre_git_cfg = {}
        claimed_state_id = in_prog_state_id
        publish_started = False
        terminal_ok = False
        failure_reason = ""
        try:
            if not no_push:
                check_remote_base(repo_root, base_branch, target_sha, "preflight")
                if get_remote_branch_sha(repo_root, branch) != pre_branch_sha:
                    raise RuntimeError(f"Remote origin/{branch} changed during preflight.")
                # Persist claim_pending BEFORE sending mutation so lost ACK never strands an untracked In Progress ticket!
                state["stage"] = "claim_pending"
                save_checkpoint(run_dir, latest_file, state)
                before_claim = client.get_issue_ownership_snapshot(issue["id"])
                if (before_claim["state_id"] != pre_claim_state_id
                        or before_claim["updated_at"] != str(issue.get("updatedAt") or "")
                        or any(before_claim[key] != value for key, value in state["claimed_ownership"].items())):
                    raise RuntimeError("Linear issue changed while preparing claim. Rerun with its current brief and state.")
                _check_shutdown()
                claim_attempted = True
                claimed_st = client.update_issue_state(issue, "In Progress")
                claimed_state_id = str(claimed_st.get("id") or in_prog_state_id)
                moved_in_progress = True
            state["stage"] = "in_progress"
            state["claimed_state_id"] = claimed_state_id
            expected_ownership = client.get_issue_ownership_snapshot(issue["id"]) if not no_push else {}
            if not no_push and (
                expected_ownership["state_id"] != claimed_state_id or
                any(expected_ownership[key] != value for key, value in state["claimed_ownership"].items())
            ):
                raise RuntimeError("Linear ownership changed while claiming the reviewed brief.")
            save_checkpoint(run_dir, latest_file, state)

            pre_git_cfg = snapshot_local_git_config(worktree)

            pr_feedback = None
            if not no_push and (gh_repo or os.environ.get("AGENT_DISPATCH_FORCE_GH") == "1"):
                observed_pr = fetch_open_pr_for_branch(repo_root, gh_repo, branch)
                if preflight_pr and (not observed_pr or observed_pr["number"] != preflight_pr["number"]):
                    raise RuntimeError(
                        f"Open PR #{preflight_pr['number']} changed during preflight (human action preserved)."
                    )
                if observed_pr:
                    _validate_open_draft_pr(observed_pr, base_branch=base_branch, context="pre-worker PR check")
                    state["pr_number"] = observed_pr["number"]
                    save_checkpoint(run_dir, latest_file, state)
                    pr_feedback = fetch_open_pr_feedback(repo_root, gh_repo, observed_pr["number"])
            feedback: str | None = pr_feedback
            prior_review_findings: dict[str, list[str]] | None = None
            discovered_seen: set[str] = set()
            all_discovered: list[str] = []
            max_attempts = 1 + max_rework
            last_verify_res: dict[str, Any] = {}
            last_review_res: dict[str, Any] = {}

            for attempt in range(1, max_attempts + 1):
                _check_shutdown()
                log(f"=== {issue['identifier']} Attempt {attempt}/{max_attempts} | worker={worker.label} ===")

                for path, digest in worker_artifacts.items():
                    assert_sha256_intact(path, digest, path.name)
                w_prompt = build_worker_prompt(
                    issue["identifier"],
                    auth_brief_path,
                    verify_cmd,
                    allow_gate_edits=allow_gate_edits,
                    standard_paths=standard_paths,
                    authorized_gate_patterns=brief_gate_pats,
                    feedback=feedback,
                )
                try:
                    w_res = invoke_harness(
                        worker,
                        w_prompt,
                        worktree=worktree,
                        run_dir=run_dir,
                        schema=WORKER_SCHEMA,
                        schema_file=run_dir / "worker-schema.json",
                        prompt_file=run_dir / f"prompt-worker-r{attempt}.md",
                        out_file=run_dir / f"worker-r{attempt}.json",
                        read_only=False,
                        session_label=f"{issue['identifier']}-worker-r{attempt}",
                        trace_sink=sessions,
                        attach_files=[auth_brief_path, *standard_paths],
                        timeout=worker_timeout,
                    )
                except subprocess.TimeoutExpired:
                    if not no_push:
                        _assert_no_external_tampering(
                            client, repo_root, worktree, branch, base_branch, issue["id"],
                            pre_branch_sha, target_sha, pre_git_cfg, expected_ownership, f"worker timeout attempt {attempt}",
                            allow_gitattributes_edit=allow_root_gitattributes,
                        )
                    feedback = (
                        f"Previous worker attempt timed out after {worker_timeout}s. "
                        "Inspect current partial edits in the worktree, keep changes minimal, verify, and return JSON promptly."
                    )
                    log(f"{issue['identifier']} worker timed out on attempt {attempt} ({worker_timeout}s); routing to rework.")
                    continue

                if not no_push:
                    _assert_no_external_tampering(
                        client, repo_root, worktree, branch, base_branch, issue["id"],
                        pre_branch_sha, target_sha, pre_git_cfg, expected_ownership, f"worker attempt {attempt}",
                        allow_gitattributes_edit=allow_root_gitattributes,
                    )
                else:
                    # Even in --no-push mode, verify local git config / .gitattributes were not tampered with!
                    cur_cfg = snapshot_local_git_config(worktree)
                    if cur_cfg["local_config_sha"] != pre_git_cfg.get("local_config_sha"):
                        raise RuntimeError(f"Unauthorized git config tampering during worker attempt {attempt} (.git/config modified).")
                    if not allow_root_gitattributes and cur_cfg["gitattributes_sha"] != pre_git_cfg.get("gitattributes_sha"):
                        raise RuntimeError(f"Unauthorized .gitattributes tampering during worker attempt {attempt}.")

                for raw_item in w_res.get("discovered_issues") or []:
                    norm = raw_item.strip().lower()
                    if norm and norm not in discovered_seen:
                        discovered_seen.add(norm)
                        all_discovered.append(f"[attempt {attempt}] {redact_secrets(raw_item.strip())}")

                if w_res["status"] == "blocked":
                    _release_setup_files(worktree, setup_files)
                    _stash_dirty_worktree_for_safe_rerun(worktree, f"{run_id}-blocked", attr_source=base_sha)
                    failure_reason = f"Worker reported blocked: {redact_secrets(w_res['blockers'])}"
                    state["stage"] = "worker_blocked"
                    state["sessions"] = sessions
                    save_checkpoint(run_dir, latest_file, state)
                    return {
                        "issue": issue["identifier"],
                        "status": "worker_blocked",
                        "attempt": attempt,
                        "branch": branch,
                        "worktree": str(worktree),
                        "run_dir": str(run_dir),
                        "blockers": redact_secrets(w_res["blockers"]),
                        "summary": redact_secrets(w_res["summary"]),
                        "discovered_issues": all_discovered,
                        "sessions": sessions,
                    }

                verify_worktree_branch_integrity(worktree, repo_common, branch, base_sha)
                # The setup paths stay excluded across rework, even if verification writes to them.
                candidate_sha, staged_secret_hits = orchestrator_commit(
                    worktree, issue["identifier"], issue["title"], attempt, setup_paths=tuple(setup_files),
                    attr_source=base_sha,
                )
                if staged_secret_hits:
                    if any("ticket title" in h for h in staged_secret_hits):
                        _release_setup_files(worktree, setup_files)
                        _stash_dirty_worktree_for_safe_rerun(worktree, f"{run_id}-title-secret", attr_source=base_sha)
                        failure_reason = "Secret detected in ticket title / commit message:\n" + "\n".join(f"- {s}" for s in staged_secret_hits)
                        state["stage"] = "secret_in_metadata"
                        state["sessions"] = sessions
                        save_checkpoint(run_dir, latest_file, state)
                        return {
                            "issue": issue["identifier"],
                            "status": "secret_in_metadata",
                            "error": failure_reason,
                            "branch": branch,
                            "worktree": str(worktree),
                            "run_dir": str(run_dir),
                            "sessions": sessions,
                        }
                    feedback = "Secret scan blocked staging (remove secrets/credential files and retry):\n" + "\n".join(
                        f"- {s}" for s in staged_secret_hits
                    )
                    log(f"{issue['identifier']} staged secret scan triggered rework on attempt {attempt}.")
                    continue

                diff_nonempty = run_cmd(
                    git_cmd("diff", "-z", "--name-only", f"{base_sha}..{candidate_sha}", attr_source=base_sha),
                    cwd=worktree,
                    check=True,
                    env_role="orchestrator",
                ).stdout.strip("\x00")
                if not diff_nonempty:
                    feedback = "Net diff against base commit is empty. Implement the ticket acceptance criteria."
                    continue

                # Full commit-range secret scan (catches secrets in history, commit messages, and merge commits!)
                range_secret_hits = scan_range_for_secrets(worktree, base_sha, candidate_sha)
                if range_secret_hits:
                    failure_reason = "Secret detected in commit history:\n" + "\n".join(f"- {s}" for s in range_secret_hits)
                    state["stage"] = "secret_in_history"
                    state["sessions"] = sessions
                    save_checkpoint(run_dir, latest_file, state)
                    return {
                        "issue": issue["identifier"],
                        "status": "secret_in_history",
                        "error": failure_reason,
                        "branch": branch,
                        "worktree": str(worktree),
                        "run_dir": str(run_dir),
                        "sessions": sessions,
                    }

                # Granular Protected paths gate (--no-renames -z)
                prot_violations = check_protected_paths(
                    worktree,
                    base_sha,
                    candidate_sha,
                    allowed_patterns=brief_gate_pats,
                    allow_all=allow_gate_edits,
                )
                if prot_violations:
                    feedback = (
                        f"Protected policy/gate files were modified. Restore them to base commit `{base_sha}` "
                        f"(e.g., `git checkout {base_sha} -- <path>`):\n"
                        + "\n".join(f"- {v}" for v in prot_violations)
                    )
                    log(f"{issue['identifier']} protected-paths gate FAILED on attempt {attempt}.")
                    continue

                # Granular Deterministic test-integrity diff gate (--no-renames -z)
                det_test_violations = check_test_integrity_diff(
                    worktree,
                    base_sha,
                    candidate_sha,
                    allowed_patterns=brief_test_pats,
                    allow_all=allow_test_edits,
                )
                if det_test_violations:
                    feedback = "Deterministic test-integrity check FAILED (restore skipped/deleted tests):\n" + "\n".join(
                        f"- {v}" for v in det_test_violations
                    )
                    log(f"{issue['identifier']} deterministic test-integrity gate FAILED on attempt {attempt}.")
                    continue

                # The candidate can add a suite or change an authorized verification target.
                verify_cmd = detect_verify_command(worktree, verify_cmd_override)
                last_verify_res = run_verify_gate(
                    worktree,
                    verify_cmd,
                    allow_no_verify=allow_no_verify,
                    log_file=run_dir / f"verify-r{attempt}.log",
                    repo_key=rkey,
                    timeout=verify_timeout,
                )
                if not last_verify_res["passed"]:
                    feedback = (
                        f"Deterministic verification failed (`{last_verify_res['command']}`, exit {last_verify_res.get('returncode')}):\n"
                        f"```\n{last_verify_res['output'][-2500:]}\n```"
                    )
                    log(f"{issue['identifier']} verify FAILED on attempt {attempt}.")
                    continue

                # Check ownership BEFORE review as well (so human canceling during verify halts immediately!)
                if not no_push:
                    _assert_no_external_tampering(
                        client, repo_root, worktree, branch, base_branch, issue["id"],
                        pre_branch_sha, target_sha, pre_git_cfg, expected_ownership, f"verify attempt {attempt}",
                        allow_gitattributes_edit=allow_root_gitattributes,
                    )

                # Cross-vendor read-only two-axis review
                last_review_res = run_two_axis_review(
                    reviewer,
                    worktree,
                    run_dir,
                    base_sha,
                    candidate_sha,
                    auth_brief_path,
                    auth_brief_sha256,
                    baseline_std_dir,
                    baseline_std_hashes,
                    attempt,
                    prior_findings=prior_review_findings,
                    pr_feedback=pr_feedback,
                    trace_sink=sessions,
                    review_timeout=review_timeout,
                    setup_files=setup_files,
                )
                if not no_push:
                    _assert_no_external_tampering(
                        client, repo_root, worktree, branch, base_branch, issue["id"],
                        pre_branch_sha, target_sha, pre_git_cfg, expected_ownership, f"review attempt {attempt}",
                        allow_gitattributes_edit=allow_root_gitattributes,
                    )

                if last_review_res["passed"]:
                    safe_summary = redact_secrets(w_res["summary"])
                    safe_tests_run = [redact_secrets(t) for t in (w_res.get("tests_run") or [])]
                    pr_body = build_pr_body(
                        issue,
                        candidate_sha,
                        worker,
                        reviewer,
                        safe_summary,
                        safe_tests_run,
                        last_verify_res,
                        last_review_res,
                        all_discovered,
                        gate_authorizations=gate_authorizations,
                    )
                    state.update(
                        {
                            "pre_push_sha": pre_branch_sha,
                            "stage": "verified_and_reviewed",
                            "attempt": attempt,
                            "max_attempts": max_attempts,
                            "candidate_sha": candidate_sha,
                            "worker_summary": safe_summary,
                            "tests_run": safe_tests_run,
                            "verify": {"command": redact_secrets(str(last_verify_res.get("command") or "")), "ran": last_verify_res.get("ran"), "passed": True},
                            "review": last_review_res,
                            "discovered_issues": all_discovered,
                            "sessions": sessions,
                            "pr_body": pr_body,
                            "push_attempted": False,
                            "pushed": False,
                            "pr_url": "",
                            "linear_state_synced": False,
                            "linear_comment_posted": False,
                        }
                    )
                    save_checkpoint(run_dir, latest_file, state)

                    if no_push:
                        terminal_ok = True
                        state["stage"] = "passed_local"
                        save_checkpoint(run_dir, latest_file, state)
                        return {
                            "issue": issue["identifier"],
                            "status": "passed_local",
                            "attempt": attempt,
                            "branch": branch,
                            "commit": candidate_sha,
                            "worktree": str(worktree),
                            "run_dir": str(run_dir),
                            "worker": worker.label,
                            "reviewer": reviewer.label,
                            "verify": state["verify"],
                            "review": last_review_res,
                            "discovered_issues": all_discovered,
                            "sessions": sessions,
                        }

                    publish_started = True
                    try:
                        reconcile_publish(client, issue, repo_root, run_dir, latest_file, state, allow_branch_only=allow_branch_only)
                    except Exception as pub_exc:
                        if not state.get("pushed") and state.get("push_attempted"):
                            try:
                                if get_remote_branch_sha(repo_root, branch, ignore_shutdown=True) == state.get("candidate_sha"):
                                    state["pushed"] = True
                                    if state.get("stage") in ("verified_and_reviewed", "pushing"):
                                        state["stage"] = "pushed"
                                    save_checkpoint(run_dir, latest_file, state)
                            except BaseException:
                                pass
                        failure_reason = (
                            f"Publish interrupted at stage '{state['stage']}' (fix & run `agent-dispatch resume {issue['identifier']}`): {pub_exc}"
                        )
                        return {
                            "issue": issue["identifier"],
                            "status": "publish_incomplete",
                            "stage": state["stage"],
                            "push_attempted": bool(state.get("push_attempted")),
                            "pushed": bool(state.get("pushed")),
                            "pr_url": state.get("pr_url", ""),
                            "error": redact_secrets(str(pub_exc)),
                            "commit": candidate_sha,
                            "branch": branch,
                            "run_dir": str(run_dir),
                            "resume_cmd": f"agent-dispatch resume {issue['identifier']}",
                            "sessions": sessions,
                        }

                    terminal_ok = True
                    return {
                        "issue": issue["identifier"],
                        "status": "passed" if state.get("stage") == "completed" else "passed_branch_only",
                        "delivery_mode": state.get("delivery_mode", "draft_pr"),
                        "attempt": attempt,
                        "branch": branch,
                        "commit": candidate_sha,
                        "worktree": str(worktree),
                        "run_dir": str(run_dir),
                        "pr_url": state.get("pr_url", ""),
                        "worker": worker.label,
                        "reviewer": reviewer.label,
                        "verify": state["verify"],
                        "review": last_review_res,
                        "discovered_issues": all_discovered,
                        "sessions": sessions,
                    }

                prior_review_findings = {
                    "standards": list(last_review_res["standards"].get("hard_findings") or []),
                    "spec": list(last_review_res["spec"].get("hard_findings") or []),
                }
                fb_lines: list[str] = []
                if pr_feedback:
                    fb_lines += ["### Open PR Feedback (must stay addressed):", pr_feedback, ""]
                for axis_name in ("standards", "spec"):
                    ax = last_review_res[axis_name]
                    if ax.get("hard_findings") or ax.get("test_integrity_violation") or ax.get("verdict") == "fail":
                        fb_lines.append(f"### {axis_name.upper()} Findings:")
                        if ax.get("test_integrity_violation"):
                            fb_lines.append("- [REDLINE] Test integrity violation detected. Restore assertion strength.")
                        for f in ax.get("hard_findings", []):
                            fb_lines.append(f"- {f}")
                        if not ax.get("hard_findings") and ax.get("summary"):
                            fb_lines.append(f"- {ax['summary']}")
                feedback = "\n".join(fb_lines) or "Review failed; address all review feedback."
                log(f"{issue['identifier']} review FAILED on attempt {attempt}.")

            _release_setup_files(worktree, setup_files)
            _stash_dirty_worktree_for_safe_rerun(worktree, f"{run_id}-max-rework", attr_source=base_sha)
            failure_reason = f"Exhausted {max_attempts} attempts ({max_rework} rework rounds). Last feedback:\n{feedback or 'unknown'}"
            state["stage"] = "failed_max_rework"
            state["sessions"] = sessions
            save_checkpoint(run_dir, latest_file, state)
            return {
                "issue": issue["identifier"],
                "status": "failed_max_rework",
                "attempts": max_attempts,
                "branch": branch,
                "worktree": str(worktree),
                "run_dir": str(run_dir),
                "worker": worker.label,
                "reviewer": reviewer.label,
                "last_verify": last_verify_res,
                "last_review": last_review_res,
                "discovered_issues": all_discovered,
                "sessions": sessions,
            }
        except BaseException as exc:
            failure_reason = f"Unhandled orchestrator error ({type(exc).__name__}): {exc}"
            if not publish_started and (state["stage"] != "claim_pending" or not claim_attempted):
                state["stage"] = "error"
                if (worktree / ".git").exists() and pre_git_cfg and not _is_shutdown_requested():
                    cur_cfg = snapshot_local_git_config(worktree)
                    cfg_ok = cur_cfg["local_config_sha"] == pre_git_cfg.get("local_config_sha") and (
                        allow_root_gitattributes or cur_cfg["gitattributes_sha"] == pre_git_cfg.get("gitattributes_sha")
                    )
                    if (cfg_ok and
                            run_cmd(git_cmd("branch", "--show-current"), cwd=worktree, env_role="orchestrator").stdout.strip() == branch):
                        _release_setup_files(worktree, setup_files)
                        _stash_dirty_worktree_for_safe_rerun(worktree, f"{run_id}-error", attr_source=base_sha)
            state["error"] = redact_secrets(str(exc))
            state["sessions"] = sessions
            try:
                save_checkpoint(run_dir, latest_file, state)
            except Exception:
                pass
            raise
        finally:
            if (moved_in_progress or claim_attempted) and not terminal_ok and not no_push:
                # Signal-safe remote push fact check BEFORE any Linear I/O: persist `pushed: True` immediately once confirmed!
                if not state.get("pushed") and (publish_started or state.get("push_attempted")):
                    try:
                        if get_remote_branch_sha(repo_root, branch, ignore_shutdown=True) == state.get("candidate_sha"):
                            state["pushed"] = True
                            state["push_attempted"] = True
                            if state.get("stage") in ("verified_and_reviewed", "pushing"):
                                state["stage"] = "pushed"
                            save_checkpoint(run_dir, latest_file, state)
                    except BaseException as probe_exc:
                        log(f"Warning: remote push probe failed during cleanup for {issue['identifier']}: {redact_secrets(str(probe_exc))}")

                rollback_reverted = False
                human_conflict_in_rollback = False
                try:
                    live_iss = client.get_issue(issue["id"])
                    live_st = live_iss.get("state") or {}
                    live_st_type = str(live_st.get("type") or "")
                    live_st_id = str(live_st.get("id") or "")
                    # If claim ACK was lost and server NEVER moved it to In Progress, nothing to roll back!
                    if not moved_in_progress and live_st_id == pre_claim_state_id:
                        pass
                    else:
                        human_took_over = not _claim_metadata_matches(live_iss, state) or (live_st_type in ("completed", "canceled")) or (
                            bool(claimed_state_id) and live_st_id != claimed_state_id
                        )

                        if publish_started:
                            if live_st_type not in ("completed", "canceled") and _claim_metadata_matches(live_iss, state):
                                client.ensure_label_and_add(live_iss, "dispatch:publish-incomplete")
                            client.add_comment(
                                live_iss["id"],
                                "\n".join(
                                    [
                                        f"### [agent-dispatch] Publish Interrupted at `{state.get('stage')}`",
                                        f"- **Branch / SHA**: `{branch}` (`{state.get('candidate_sha', '')[:8]}`)",
                                        f"- **Remote Push Status**: {'confirmed' if state.get('pushed') else 'attempted (verify via resume)'}",
                                        f"- **PR**: {state.get('pr_url') or 'not confirmed yet'}",
                                        f"- **Resume**: `agent-dispatch resume {issue['identifier']}`",
                                        f"- **Run Logs**: `{run_dir}`",
                                        f"- **Reason**:\n{redact_secrets(failure_reason)[:2500]}",
                                    ]
                                ),
                            )
                        elif human_took_over:
                            human_conflict_in_rollback = True
                            client.add_comment(
                                live_iss["id"],
                                "\n".join(
                                    [
                                        f"### [agent-dispatch] Halted (Preserved Current State `{live_st.get('name', 'unknown')}`)",
                                        f"- **Worktree**: `{worktree}` (`{branch}`)",
                                        f"- **Run Logs**: `{run_dir}`",
                                        f"- **Reason**:\n{redact_secrets(failure_reason)[:2500]}",
                                    ]
                                ),
                            )
                        else:
                            # CRITICAL ORDERING: add `dispatch:failed` label FIRST, THEN revert state!
                            # Guarantees ticket NEVER returns to Todo+agent-ready without dispatch:failed if interrupted!
                            client.ensure_label_and_add(live_iss, "dispatch:failed")
                            live_iss = client.get_issue(issue["id"])
                            if live_iss["state"]["id"] != claimed_state_id or not _claim_metadata_matches(live_iss, state):
                                human_conflict_in_rollback = True
                                raise RuntimeError("Human Linear ownership changed during rollback.")
                            if pre_claim_state_id:
                                client.update_issue_state_by_id(live_iss, pre_claim_state_id, label_hint=pre_claim_state_name)
                            else:
                                client.update_issue_state(live_iss, "Todo")
                            rollback_reverted = True
                            rollback_marker = f"<!-- agent-dispatch-rollback:{run_id} -->"
                            sess_lines = [
                                f"- `{s.get('role')}` ({s.get('harness')}): `{s.get('resume_cmd') or s.get('conversation_link') or s.get('stdout_log')}`"
                                for s in sessions
                            ]
                            comment_parts = [
                                rollback_marker,
                                f"### [agent-dispatch] Halted -> Reverted to `{pre_claim_state_name}` (`dispatch:failed`)",
                                f"- **Worktree (local, NOT pushed by this run)**: `{worktree}` (`{branch}`)",
                                f"- **Run Logs**: `{run_dir}`",
                                f"- **Reason**:\n{redact_secrets(failure_reason)[:2500]}",
                            ]
                            if sess_lines:
                                comment_parts += ["", "**Sessions:**", *sess_lines]
                            client.add_comment(live_iss["id"], "\n".join(comment_parts))
                except BaseException as cleanup_exc:
                    log(f"Warning: failed Linear cleanup for {issue['identifier']}: {redact_secrets(str(cleanup_exc))}")
                    if not publish_started and moved_in_progress and not human_conflict_in_rollback:
                        state["rollback_from_stage"] = state.get("rollback_from_stage") or state.get("stage")
                        state["stage"] = "rollback_pending"
                        state["rollback_state_reverted"] = rollback_reverted
                        state["failure_reason"] = redact_secrets(failure_reason)[:2500]
                        state["rollback_error"] = redact_secrets(str(cleanup_exc))[:1000]
                        state["sessions"] = sessions
                        try:
                            save_checkpoint(run_dir, latest_file, state)
                        except Exception as save_exc:
                            log(f"Warning: failed persisting rollback_pending checkpoint for {issue['identifier']}: {redact_secrets(str(save_exc))}")


# ---------------------------------------------------------------------------
# Subcommand Handlers
# ---------------------------------------------------------------------------

def cmd_run(args: argparse.Namespace) -> int:
    repo_root = get_repo_root(args.repo)
    client = LinearClient(resolve_linear_auth())
    repo_project = None if args.skip_project_check else resolve_project(client, repo_root, args.project)
    worker = parse_harness_spec(args.worker)
    reviewer = parse_harness_spec(args.reviewer) if args.reviewer else default_reviewer_for(worker)
    if worker.vendor == reviewer.vendor:
        log(f"Warning: worker ({worker.label}) and reviewer ({reviewer.label}) share vendor '{worker.vendor}'.")
    res = execute_ticket(
        client,
        repo_root,
        repo_project,
        args.issue,
        worker,
        reviewer,
        verify_cmd_override=args.verify_cmd,
        setup_cmd_override=args.setup_cmd,
        max_rework=args.max_rework,
        verify_timeout=args.verify_timeout,
        setup_timeout=args.setup_timeout,
        worker_timeout=args.worker_timeout,
        review_timeout=args.review_timeout,
        no_push=args.no_push,
        allow_no_verify=args.allow_no_verify,
        allow_gate_edits=args.allow_gate_edits,
        allow_test_edits=args.allow_test_edits,
        allow_dirty_docs=args.allow_dirty_docs,
        allow_branch_only=args.allow_branch_only,
        skip_baseline=args.skip_baseline,
        skip_project_check=args.skip_project_check,
        force_rerun=args.force_rerun,
        fresh=args.fresh,
    )
    print(safe_json(res, indent=2, ensure_ascii=False))
    return 0 if res.get("status") in ("passed", "passed_local", "passed_branch_only") else 1


def cmd_resume(args: argparse.Namespace) -> int:
    """Acquire canonical ticket lock FIRST, load authoritative state.json, verify repo/worktree identity, and reconcile cleanly."""
    repo_root = get_repo_root(args.repo)
    rkey = repo_cache_key(repo_root)
    cur_repo_identity = canonical_repo_identity(repo_root)
    repo_common = get_git_common_dir(repo_root)
    client = LinearClient(resolve_linear_auth())
    repo_project = None if args.skip_project_check else resolve_project(client, repo_root, args.project)

    issue = client.get_issue(args.issue)
    if not args.skip_project_check and repo_project:
        if (issue.get("project") or {}).get("id") != repo_project["id"]:
            raise RuntimeError(f"Cross-repo guard: {issue['identifier']} does not belong to project '{repo_project['name']}'.")

    t_lock = ticket_lock_path(repo_root, issue["id"])
    with file_lock(t_lock, blocking=False):
        latest_file = _cache_root() / "runs" / rkey / issue["identifier"] / "latest.json"
        if not latest_file.is_file():
            raise RuntimeError(f"No checkpoint found at {latest_file}")
        try:
            latest_data = json.loads(latest_file.read_text(encoding="utf-8"))
            if not isinstance(latest_data, dict) or not latest_data.get("run_dir"):
                raise ValueError("missing run_dir")
            run_dir = Path(latest_data["run_dir"])
            state_file = run_dir / "state.json"
            # Prefer authoritative run_dir/state.json over latest.json index to avoid split-brain on mid-write crash!
            state = json.loads(state_file.read_text(encoding="utf-8")) if state_file.is_file() else latest_data
            if not isinstance(state, dict):
                raise ValueError("state is not a JSON object")
        except (OSError, ValueError) as exc:
            raise RuntimeError(f"Corrupt checkpoint at {latest_file}: {exc}") from exc
        if state.get("issue_uuid") and state["issue_uuid"] != issue["id"]:
            raise RuntimeError(f"Checkpoint issue UUID mismatch ({state['issue_uuid']} != {issue['id']}).")
        if state.get("repo_identity") and state["repo_identity"] != cur_repo_identity:
            raise RuntimeError(
                f"Checkpoint repo_identity mismatch ({state['repo_identity']} != {cur_repo_identity}); refusing cross-repo resume."
            )
        if state.get("no_push"):
            raise RuntimeError(f"Latest run for {issue['identifier']} was `--no-push` local mode; rerun without `--no-push` to publish.")
        if state.get("stage") in ("claim_pending", "claim_released"):
            live = client.get_issue(issue["id"])
            if state["stage"] == "claim_pending":
                pre_state_id = state.get("pre_claim_state_id")
                if not pre_state_id:
                    raise RuntimeError("Interrupted claim checkpoint missing pre_claim_state_id; human state preserved.")
                if live["state"]["id"] != pre_state_id:
                    # Older claim_pending records lack an assignee/description snapshot.
                    if not state.get("claimed_ownership") or live["state"]["id"] != state.get("claimed_state_id"):
                        raise RuntimeError("Cannot verify ownership of interrupted claim; human state preserved.")
                    _require_publish_ownership(live, state)
                    client.ensure_label_and_add(live, "dispatch:failed")
                    live = client.get_issue(issue["id"])
                    _require_publish_ownership(live, state)
                    client.update_issue_state_by_id(live, pre_state_id)
                state["stage"] = "claim_released"
                save_checkpoint(run_dir, latest_file, state)
            print(safe_json({"issue": issue["identifier"], "status": "claim_released", "rerun": f"agent-dispatch run {issue['identifier']}"}))
            return 0
        if state.get("stage") in ("rollback_pending", "rollback_completed"):
            pre_state_id = state.get("pre_claim_state_id")
            pre_state_name = state.get("pre_claim_state_name") or "Todo"
            if state["stage"] == "rollback_pending":
                live = client.get_issue(issue["id"])
                if not state.get("rollback_state_reverted"):
                    if not state.get("claimed_ownership") or not state.get("claimed_state_id"):
                        raise RuntimeError("Cannot verify ownership of pending rollback; human state preserved.")
                    _require_publish_ownership(live, state)
                    # CRITICAL ORDERING: add `dispatch:failed` label FIRST, THEN revert state!
                    client.ensure_label_and_add(live, "dispatch:failed")
                    live = client.get_issue(issue["id"])
                    _require_publish_ownership(live, state)
                    if pre_state_id:
                        client.update_issue_state_by_id(live, pre_state_id, label_hint=pre_state_name)
                    else:
                        client.update_issue_state(live, "Todo")
                    state["rollback_state_reverted"] = True
                    save_checkpoint(run_dir, latest_file, state)
                rollback_marker = f"<!-- agent-dispatch-rollback:{state.get('run_id', '')} -->"
                existing_comments = (live.get("comments") or {}).get("nodes", [])
                if not any(rollback_marker in (c.get("body") or "") for c in existing_comments):
                    sess_lines = [
                        f"- `{s.get('role')}` ({s.get('harness')}): `{s.get('resume_cmd') or s.get('conversation_link') or s.get('stdout_log')}`"
                        for s in (state.get("sessions") or [])
                    ]
                    reason_text = state.get("failure_reason") or state.get("error") or "Pre-publish failure (rollback recovered via resume)."
                    comment_parts = [
                        rollback_marker,
                        f"### [agent-dispatch] Halted -> Reverted to `{pre_state_name}` (`dispatch:failed`, recovered via resume)",
                        f"- **Worktree (local, NOT pushed by this run)**: `{state.get('worktree', '')}` (`{state.get('branch', '')}`)",
                        f"- **Run Logs**: `{run_dir}`",
                        f"- **Reason**:\n{redact_secrets(str(reason_text))[:2500]}",
                    ]
                    if sess_lines:
                        comment_parts += ["", "**Sessions:**", *sess_lines]
                    client.add_comment(live["id"], "\n".join(comment_parts))
                state["stage"] = "rollback_completed"
                state.pop("rollback_error", None)
                save_checkpoint(run_dir, latest_file, state)
            print(
                safe_json(
                    {
                        "issue": issue["identifier"],
                        "status": "rollback_completed",
                        "linear_state": pre_state_name,
                        "rerun": f"agent-dispatch run {issue['identifier']}",
                    },
                    indent=2,
                    ensure_ascii=False,
                )
            )
            return 0
        if (state.get("stage") not in (*PUBLISH_STAGES, *COMPLETED_STAGES)
                or (state.get("review") or {}).get("passed") is not True
                or (state.get("verify") or {}).get("passed") is not True
                or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", state.get("candidate_sha") or "")
                or state.get("branch") != f"feat/{issue['identifier'].lower()}"):
            raise RuntimeError(f"Checkpoint at {state.get('stage')!r} lacks verified publish evidence.")
        worktree = _worktree_cache_path(rkey, issue["identifier"].upper())
        if Path(state["worktree"]) != worktree:
            raise RuntimeError("Checkpoint worktree differs from the managed ticket path.")
        if not (worktree / ".git").exists():
            raise RuntimeError(f"Worktree missing at {worktree}; cannot reconcile.")
        if get_git_common_dir(worktree) != repo_common:
            raise RuntimeError(f"Worktree {worktree} does not belong to repository {repo_root}.")
        live_issue = client.get_issue(issue["id"])
        if (live_issue.get("state") or {}).get("type") in ("completed", "canceled"):
            raise RuntimeError(f"{live_issue['identifier']} is already {live_issue['state']['name']}; nothing to resume.")

        if state.get("stage") in COMPLETED_STAGES:
            ro_out = verify_completed_publish_readonly(client, live_issue, repo_root, state)
            print(safe_json(ro_out, indent=2, ensure_ascii=False))
            return 0

        reconcile_publish(
            client,
            live_issue,
            repo_root,
            run_dir,
            latest_file,
            state,
            allow_branch_only=bool(state.get("allow_branch_only")),
        )

    print(
        safe_json(
            {
                "issue": issue["identifier"],
                "status": "passed" if state.get("stage") == "completed" else "passed_branch_only",
                "reconciled": True,
                "commit": state["candidate_sha"],
                "pr_url": state.get("pr_url", ""),
                "linear_state": (live_issue.get("state") or {}).get("name"),
                "run_dir": str(run_dir),
                "sessions": state.get("sessions", []),
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0


def collect_runnable_tickets(
    client: LinearClient,
    issues: list[dict[str, Any]],
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]]:
    runnable: list[dict[str, Any]] = []
    blocked: list[dict[str, Any]] = []
    skipped: list[dict[str, Any]] = []
    for iss in issues:
        ok, reason = is_ready_for_frontier(iss)
        if not ok:
            skipped.append({"id": iss["identifier"], "title": iss["title"], "reason": reason})
            continue
        inv_rels = client.get_issue_inverse_relations(iss["id"])
        iss["inverseRelations"] = {"nodes": inv_rels}
        active_blks, canceled_blks = classify_blockers(iss)
        if active_blks or canceled_blks:
            blocked.append(
                {
                    "id": iss["identifier"],
                    "title": iss["title"],
                    "active_blockers": active_blks,
                    "canceled_blockers": canceled_blks,
                }
            )
        else:
            runnable.append(iss)
    runnable.sort(key=lambda x: (x.get("priority") or 99, x["identifier"]))
    return runnable, blocked, skipped


def extract_active_touches(started_issues: list[dict[str, Any]]) -> tuple[set[str], bool]:
    """Collect Touches currently held by in-flight (In Progress / In Review) sibling tickets for cross-wave serialization."""
    active_touches: set[str] = set()
    active_unscoped = False
    for iss in started_issues:
        if (iss.get("children") or {}).get("nodes"):
            continue
        t = parse_touches(iss.get("description") or "")
        if t:
            active_touches |= t
        else:
            lbls = {l["name"].lower() for l in (iss.get("labels") or {}).get("nodes", [])}
            if "agent-ready" in lbls:
                active_unscoped = True
    return active_touches, active_unscoped


def select_non_overlapping_wave(
    runnable: list[dict[str, Any]],
    *,
    limit: int | None = None,
    active_claimed_touches: set[str] | None = None,
    active_has_unscoped: bool = False,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    """
    Pick ONE conflict-free wave to run against current base branch, also respecting Touches already held by
    in-flight (In Progress / In Review) sibling tickets across waves!
    """
    selected: list[dict[str, Any]] = []
    deferred: list[dict[str, Any]] = []
    claimed_touches: set[str] = set(active_claimed_touches or set())
    has_unscoped = bool(active_has_unscoped)

    for iss in runnable:
        if limit is not None and len(selected) >= limit:
            deferred.append({"id": iss["identifier"], "reason": "limit_reached"})
            continue
        t = parse_touches(iss.get("description") or "")
        if not t:
            if not selected and not claimed_touches and not has_unscoped:
                selected.append(iss)
                has_unscoped = True
            else:
                deferred.append({"id": iss["identifier"], "reason": "undeclared_touches_deferred"})
        else:
            conflicts = touches_overlap(t, claimed_touches)
            if has_unscoped or conflicts:
                deferred.append({"id": iss["identifier"], "reason": f"overlapping_touches:{conflicts or ['unscoped']}"})
            else:
                selected.append(iss)
                claimed_touches |= t
    return selected, deferred


@contextlib.contextmanager
def reserve_touches(repo_identity: str, touches: set[str]) -> Iterator[bool]:
    """Hold shared ancestors and exclusive resources for the lifetime of a batch ticket."""
    lock_root = _cache_root() / "locks" / f"touches-{repo_identity}"
    lock_root.mkdir(parents=True, exist_ok=True)
    modes = {"": fcntl.LOCK_SH if touches else fcntl.LOCK_EX}
    for resource in touches:
        parts = resource.split("/")
        for depth in range(1, len(parts)):
            modes.setdefault("/".join(parts[:depth]), fcntl.LOCK_SH)
        modes[resource] = fcntl.LOCK_EX
    with contextlib.ExitStack() as locks:
        for resource, mode in sorted(modes.items()):
            fh = locks.enter_context((lock_root / sha256_text(resource)).open("a"))
            try:
                fcntl.flock(fh.fileno(), mode | fcntl.LOCK_NB)
            except BlockingIOError:
                yield False
                return
        yield True


def run_batch_safely(
    client: LinearClient,
    repo_root: Path,
    repo_project: dict[str, Any] | None,
    runnable: list[dict[str, Any]],
    args: argparse.Namespace,
    *,
    active_claimed_touches: set[str] | None = None,
    active_has_unscoped: bool = False,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    worker = parse_harness_spec(args.worker)
    reviewer = parse_harness_spec(args.reviewer) if args.reviewer else default_reviewer_for(worker)
    if worker.vendor == reviewer.vendor:
        log(f"Warning: worker ({worker.label}) and reviewer ({reviewer.label}) share vendor '{worker.vendor}'.")

    wave, deferred = select_non_overlapping_wave(
        runnable,
        limit=getattr(args, "limit", None),
        active_claimed_touches=active_claimed_touches,
        active_has_unscoped=active_has_unscoped,
    )
    results: list[dict[str, Any]] = []

    repo_identity = canonical_repo_identity(repo_root)

    def _safe_exec(iss: dict[str, Any]) -> dict[str, Any]:
        ident = iss["identifier"]
        touches = parse_touches(iss.get("description") or "")
        if _is_shutdown_requested():
            return {"issue": ident, "status": "cancelled_by_signal"}
        try:
            with reserve_touches(repo_identity, touches) as reserved:
                if not reserved:
                    return {"issue": ident, "status": "deferred", "reason": "overlapping_touches_in_another_batch"}
                # The preceding wave can finish between selection and taking the local reservation.
                project_id = (iss.get("project") or repo_project or {}).get("id")
                if not project_id:
                    raise RuntimeError("Batch ticket has no Linear project for Touches reconciliation.")
                started = client.list_project_issues(project_id, state_type="started")
                active, unscoped = extract_active_touches(started)
                if unscoped or (active and not touches) or touches_overlap(touches, active):
                    return {"issue": ident, "status": "deferred", "reason": "overlapping_active_touches"}
                return execute_ticket(
                    client,
                    repo_root,
                    repo_project,
                    ident,
                    worker,
                    reviewer,
                    verify_cmd_override=args.verify_cmd,
                    setup_cmd_override=args.setup_cmd,
                    max_rework=args.max_rework,
                    verify_timeout=args.verify_timeout,
                    setup_timeout=args.setup_timeout,
                    worker_timeout=args.worker_timeout,
                    review_timeout=args.review_timeout,
                    no_push=args.no_push,
                    allow_no_verify=args.allow_no_verify,
                    allow_gate_edits=args.allow_gate_edits,
                    allow_test_edits=args.allow_test_edits,
                    allow_dirty_docs=args.allow_dirty_docs,
                    allow_branch_only=args.allow_branch_only,
                    skip_baseline=args.skip_baseline,
                    skip_project_check=args.skip_project_check,
                    force_rerun=args.force_rerun,
                    fresh=args.fresh,
                    auto_claimed=True,
                    reserved_touches=touches,
                )
        except (KeyboardInterrupt, SystemExit):
            return {"issue": ident, "status": "cancelled_by_signal"}
        except Exception as exc:
            return {"issue": ident, "status": "error", "error": redact_secrets(str(exc))}

    pool = concurrent.futures.ThreadPoolExecutor(max_workers=max(1, args.max_parallel))
    try:
        futs = {pool.submit(_safe_exec, iss): iss["identifier"] for iss in wave}
        pending = set(futs)
        cancelled_for_shutdown = False
        while pending:
            done, pending = concurrent.futures.wait(
                pending, timeout=0.1, return_when=concurrent.futures.FIRST_COMPLETED
            )
            for fut in done:
                result = fut.result()
                if result["status"] == "deferred":
                    deferred.append({"id": result["issue"], "reason": result["reason"]})
                else:
                    results.append(result)
            if _is_shutdown_requested() and not cancelled_for_shutdown:
                cancelled_for_shutdown = True
                for fut in list(pending):
                    if fut.cancel():
                        pending.discard(fut)
                _kill_all_active_children(wait_sigkill=False)
        if _is_shutdown_requested():
            _check_shutdown()
    except (KeyboardInterrupt, SystemExit):
        request_shutdown(signal.SIGTERM)
        _kill_all_active_children(wait_sigkill=True)
        pool.shutdown(wait=False, cancel_futures=True)
        raise
    else:
        pool.shutdown(wait=True)
    return results, deferred


def cmd_frontier(args: argparse.Namespace) -> int:
    repo_root = get_repo_root(args.repo)
    client = LinearClient(resolve_linear_auth())
    proj = resolve_project(client, repo_root, args.project)
    issues = client.list_project_issues(proj["id"], state_type="unstarted")
    started = client.list_project_issues(proj["id"], state_type="started")
    active_touches, active_unscoped = extract_active_touches(started)
    runnable, blocked, skipped = collect_runnable_tickets(client, issues)
    if not runnable:
        print(safe_json({"project": proj["name"], "status": "empty_frontier", "blocked": blocked, "skipped": skipped}, indent=2, ensure_ascii=False))
        return 0
    results, deferred = run_batch_safely(
        client,
        repo_root,
        proj,
        runnable,
        args,
        active_claimed_touches=active_touches,
        active_has_unscoped=active_unscoped,
    )
    print(
        safe_json(
            {
                "project": proj["name"],
                "dispatched": len(results),
                "results": results,
                "deferred_for_next_wave": deferred,
                "blocked": blocked,
                "skipped": skipped,
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0 if all(r.get("status") in ("passed", "passed_local", "passed_branch_only") for r in results) else 1


def cmd_spec(args: argparse.Namespace) -> int:
    repo_root = get_repo_root(args.repo)
    client = LinearClient(resolve_linear_auth())
    repo_project = None if args.skip_project_check else resolve_project(client, repo_root, args.project)
    parent = client.get_issue(args.parent_issue)
    if not args.skip_project_check and repo_project and (parent.get("project") or {}).get("id") != repo_project["id"]:
        raise RuntimeError(f"Cross-repo guard: parent {parent['identifier']} does not belong to project '{repo_project['name']}'.")
    children = (parent.get("children") or {}).get("nodes", [])
    if not children:
        raise RuntimeError(f"{parent['identifier']} has no child issues.")
    scheduling_project = repo_project or parent.get("project")
    if not scheduling_project:
        raise RuntimeError("Parent Spec has no Linear project for Touches reconciliation.")
    started = client.list_project_issues(scheduling_project["id"], state_type="started")
    active_touches, active_unscoped = extract_active_touches(started)
    runnable, blocked, skipped = collect_runnable_tickets(client, children)
    if not runnable:
        print(
            safe_json(
                {"parent": parent["identifier"], "status": "no_unblocked_ready_children", "blocked": blocked, "skipped": skipped},
                indent=2,
                ensure_ascii=False,
            )
        )
        return 0
    results, deferred = run_batch_safely(
        client,
        repo_root,
        scheduling_project,
        runnable,
        args,
        active_claimed_touches=active_touches,
        active_has_unscoped=active_unscoped,
    )
    print(
        safe_json(
            {
                "parent": parent["identifier"],
                "wave_dispatched": len(results),
                "results": results,
                "deferred_for_next_wave": deferred,
                "remaining_blocked": blocked,
                "note": "Merge upstream Draft PRs and mark them Done in Linear, then rerun `agent-dispatch spec` for the next wave.",
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0 if all(r.get("status") in ("passed", "passed_local", "passed_branch_only") for r in results) else 1


def cmd_review(args: argparse.Namespace) -> int:
    assert_required_rubrics_loaded()
    repo_root = get_repo_root(args.repo)
    base_ref = args.base or fetch_base_ref(repo_root, detect_default_branch(repo_root))

    base_sha = run_cmd(git_cmd("merge-base", base_ref, "HEAD"), cwd=repo_root, check=True, env_role="orchestrator").stdout.strip()
    candidate_sha = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=repo_root, check=True, env_role="orchestrator").stdout.strip()
    if run_cmd(git_cmd("status", "--porcelain"), cwd=repo_root, env_role="orchestrator").stdout.strip():
        raise RuntimeError("Working tree has uncommitted changes; commit or stash before running SHA-locked `review`.")
    if not run_cmd(git_cmd("diff", "-z", "--name-only", f"{base_sha}..{candidate_sha}", attr_source=base_sha), cwd=repo_root, check=True, env_role="orchestrator").stdout.strip("\x00"):
        raise RuntimeError(f"Empty diff between {base_sha[:8]} and {candidate_sha[:8]}.")

    reviewer = parse_harness_spec(args.reviewer or "agy:neon")
    run_dir = _cache_root() / "reviews" / f"{repo_cache_key(repo_root)}-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
    run_dir.mkdir(parents=True, exist_ok=True)
    auth_brief: Path | None = None
    auth_brief_sha256: str | None = None
    if args.issue:
        client = LinearClient(resolve_linear_auth())
        issue = client.get_issue(args.issue)
        auth_brief_content = render_issue_snapshot(issue)
        auth_brief = run_dir / "brief.md"
        atomic_write_text(auth_brief, auth_brief_content)
        auth_brief_sha256 = sha256_file(auth_brief)

    std_dir = run_dir / "baseline-standards"
    _, std_hashes = snapshot_baseline_standards(repo_root, base_sha, std_dir)
    sessions: list[dict[str, Any]] = []
    res = run_two_axis_review(
        reviewer,
        repo_root,
        run_dir,
        base_sha,
        candidate_sha,
        auth_brief,
        auth_brief_sha256,
        std_dir,
        std_hashes,
        round_num=1,
        trace_sink=sessions,
        review_timeout=args.review_timeout,
        block_added_secrets=True,
    )
    print(
        safe_json(
            {
                "reviewer": reviewer.label,
                "base_sha": base_sha,
                "candidate_sha": candidate_sha,
                "run_dir": str(run_dir),
                "sessions": sessions,
                **res,
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0 if res["passed"] else 1


def cmd_status(args: argparse.Namespace) -> int:
    repo_root = get_repo_root(args.repo)
    rkey = repo_cache_key(repo_root)
    client = LinearClient(resolve_linear_auth())
    proj = resolve_project(client, repo_root, args.project)
    unstarted = client.list_project_issues(proj["id"], state_type="unstarted")
    started = client.list_project_issues(proj["id"], state_type="started")
    runnable, blocked, skipped = collect_runnable_tickets(client, unstarted)

    wt_root = _worktree_cache_path(rkey)
    active_wts: list[dict[str, Any]] = []
    if wt_root.is_dir():
        for p in sorted(wt_root.iterdir()):
            if not p.is_dir() or p.name.startswith(".baseline-"):
                continue
            issue_uuid, _, ckpt, owner_err = read_worktree_lock_owner(repo_root, rkey, p)
            if issue_uuid:
                locked_bool = is_locked(ticket_lock_path(repo_root, issue_uuid))
                lock_state = "locked" if locked_bool else "unlocked"
            else:
                locked_bool = None
                lock_state = "unknown"
            entry: dict[str, Any] = {
                "id": p.name,
                "path": str(p),
                "locked": locked_bool,
                "lock_state": lock_state,
                "last_stage": ckpt.get("stage"),
                "pr_url": ckpt.get("pr_url"),
                "run_dir": ckpt.get("run_dir"),
            }
            if owner_err:
                entry["owner_warning"] = owner_err
            active_wts.append(entry)

    in_prog_list: list[dict[str, Any]] = []
    for i in started:
        if (i.get("children") or {}).get("nodes"):
            continue
        locked = is_locked(ticket_lock_path(repo_root, i["id"]))
        st_name = (i.get("state") or {}).get("name")
        in_prog_list.append(
            {
                "id": i["identifier"],
                "title": i["title"],
                "state": st_name,
                "active_lock": locked,
                "zombie_warning": (st_name == "In Progress" and not locked),
            }
        )

    print(
        safe_json(
            {
                "repo": str(repo_root),
                "linear_project": proj["name"],
                "frontier_ready": [
                    {"id": i["identifier"], "title": i["title"], "touches": sorted(parse_touches(i.get("description") or ""))}
                    for i in runnable
                ],
                "blocked": blocked,
                "skipped_not_ready": skipped,
                "in_progress_or_review": in_prog_list,
                "active_worktrees": active_wts,
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    checks: dict[str, Any] = {}
    ok_all = True

    missing_rubrics = [k for k in ("tdd", "standards", "spec") if not PRELOADED_REFS.get(k, "").strip()]
    checks["rubrics"] = {"ok": not missing_rubrics, "skills_root": str(SKILLS_ROOT), "missing": missing_rubrics}
    if missing_rubrics:
        ok_all = False

    try:
        client = LinearClient(resolve_linear_auth())
        teams, projects = client.list_teams_and_projects()
        team_states = {t["key"]: [s["name"] for s in (t.get("states") or {}).get("nodes", [])] for t in teams}
        checks["linear_auth"] = {"ok": True, "teams": team_states, "projects": [p["name"] for p in projects]}
    except Exception as exc:
        ok_all = False
        checks["linear_auth"] = {"ok": False, "error": redact_secrets(str(exc))}
        client = None

    try:
        gh_res = run_cmd(["gh", "auth", "status"], env_role="orchestrator")
        checks["gh_auth"] = {"ok": gh_res.returncode == 0}
        if gh_res.returncode != 0:
            ok_all = False
    except FileNotFoundError:
        ok_all = False
        checks["gh_auth"] = {"ok": False, "error": "`gh` CLI binary not found in PATH."}

    harnesses: dict[str, Any] = {}
    for name in ("codex", "agy", "opencode", "pi"):
        p = find_harness_binary(name)
        harnesses[name] = {"ok": bool(p), "path": p}
        if name in ("codex", "agy") and not p:
            ok_all = False
    checks["harnesses"] = harnesses

    try:
        repo_root = get_repo_root(args.repo)
        base_branch = detect_default_branch(repo_root)
        gh_repo = parse_github_owner_repo(repo_root)
        verify_cmd = detect_verify_command(repo_root, None)
        dirty_docs = check_dirty_docs_in_main_repo(repo_root, base_branch)
        proj_info: dict[str, Any] = {}
        if client:
            try:
                p = resolve_project(client, repo_root, args.project)
                proj_info = {"ok": True, "project": p["name"]}
            except Exception as exc:
                ok_all = False
                proj_info = {"ok": False, "error": str(exc)}
        checks["repo"] = {
            "ok": bool(verify_cmd) and not dirty_docs and proj_info.get("ok", True),
            "root": str(repo_root),
            "default_branch": base_branch,
            "github_remote": gh_repo,
            "verify_cmd": verify_cmd,
            "verify_detected": bool(verify_cmd),
            "dirty_docs": dirty_docs,
            "linear_project": proj_info,
        }
        if not verify_cmd or dirty_docs:
            ok_all = False
    except Exception as exc:
        ok_all = False
        checks["repo"] = {"ok": False, "error": str(exc)}

    print(safe_json({"ok": ok_all, "checks": checks}, indent=2, ensure_ascii=False))
    return 0 if ok_all else 1


def cleanup_baseline(repo_root: Path, rkey: str, wt: Path, force: bool) -> None:
    owner_file = _cache_root() / "baseline-owners" / rkey / wt.name
    if not owner_file.is_file() or owner_file.is_symlink() or wt.is_symlink():
        raise RuntimeError("missing baseline ownership")
    owner = json.loads(owner_file.read_text(encoding="utf-8"))
    if not isinstance(owner, dict) or not re.fullmatch(r"[0-9a-f]{64}", str(owner.get("key", ""))):
        raise RuntimeError("invalid baseline ownership")
    lock = _cache_root() / "locks" / f"baseline-{owner['key'][:16]}.lock"
    with file_lock(lock, blocking=False):
        head = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=wt, check=True, env_role="orchestrator").stdout.strip()
        branch = run_cmd(git_cmd("branch", "--show-current"), cwd=wt, check=True, env_role="orchestrator").stdout.strip()
        if branch or head != owner.get("base_sha") or wt.resolve() != get_repo_root(str(wt)):
            raise RuntimeError("baseline ownership changed")
        tracked_dirty = run_cmd(
            git_cmd("status", "--porcelain", "--untracked-files=no"), cwd=wt, check=True, env_role="orchestrator"
        ).stdout.strip()
        if tracked_dirty and not force:
            raise RuntimeError("baseline has modified tracked files")
        # Allow reclaiming detached baselines with untracked bootstrap/verify artifacts (e.g., node_modules/.venv)
        _worktree_cache_path(rkey, wt.name)
        run_cmd(git_cmd("worktree", "remove", "--force", str(wt)), cwd=repo_root, check=True, env_role="orchestrator")
        owner_file.unlink()


def cmd_cleanup(args: argparse.Namespace) -> int:
    repo_root = get_repo_root(args.repo)
    repo_common = get_git_common_dir(repo_root)
    rkey = repo_cache_key(repo_root)
    base_branch = detect_default_branch(repo_root)
    gh_repo = parse_github_owner_repo(repo_root)
    use_gh = bool(gh_repo or os.environ.get("AGENT_DISPATCH_FORCE_GH") == "1")
    wt_root = _worktree_cache_path(rkey)
    removed: list[str] = []
    skipped: list[str] = []

    with file_lock(_cache_root() / "locks" / f"repo-{rkey}.lock", blocking=True):
        base_ref = fetch_base_ref(repo_root, base_branch)
        base_sha = run_cmd(git_cmd("rev-parse", base_ref), cwd=repo_root, check=True, env_role="orchestrator").stdout.strip()

        if wt_root.is_dir():
            for wt in sorted(wt_root.iterdir()):
                if wt.is_symlink():
                    skipped.append(f"{wt.name} (symlink in worktree root; refusing delete)")
                    continue
                if not wt.is_dir():
                    continue
                if not (wt / ".git").exists():
                    skipped.append(f"{wt.name} (not a git worktree)")
                    continue
                if get_git_common_dir(wt) != repo_common:
                    skipped.append(f"{wt.name} (git-common-dir ownership mismatch; refusing delete)")
                    continue
                if wt.name.startswith(".baseline-"):
                    try:
                        cleanup_baseline(repo_root, rkey, wt, args.all)
                        removed.append(wt.name)
                    except (OSError, RuntimeError, ValueError) as exc:
                        skipped.append(f"{wt.name} ({redact_secrets(str(exc))})")
                    continue
                issue_uuid, owner_branch, _, owner_err = read_worktree_lock_owner(repo_root, rkey, wt)
                if not issue_uuid or not owner_branch:
                    skipped.append(f"{wt.name} ({owner_err or 'missing_lock_owner_metadata'}; refusing unsafe delete)")
                    continue

                try:
                    with file_lock(ticket_lock_path(repo_root, issue_uuid), blocking=False):
                        br = run_cmd(git_cmd("rev-parse", "--abbrev-ref", "HEAD"), cwd=wt, env_role="orchestrator").stdout.strip()
                        if br != owner_branch:
                            # Human switched worktree to a personal branch or detached HEAD -> NEVER delete even with --all!
                            skipped.append(
                                f"{wt.name} (branch ownership mismatch: checked out '{br}', owner '{owner_branch}'; refusing unsafe delete)"
                            )
                            continue
                        dirty = run_cmd(git_cmd("status", "--porcelain", "-z"), cwd=wt, check=True, env_role="orchestrator").stdout
                        if dirty and not args.all:
                            skipped.append(f"{wt.name} (uncommitted changes)")
                            continue
                        head_sha = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=wt, env_role="orchestrator").stdout.strip()

                        is_merged = False
                        if args.all:
                            is_merged = True
                        else:
                            # Verify merged PR matches BOTH current headRefOid AND target base_branch!
                            if use_gh and br:
                                pr_cmd = ["gh", "pr", "list", "--head", br, "--state", "merged", "--json", "number,headRefOid,baseRefName"]
                                if gh_repo:
                                    pr_cmd += ["--repo", gh_repo]
                                pr_m = run_cmd(pr_cmd, cwd=repo_root, env_role="orchestrator")
                                if pr_m.returncode == 0:
                                    for mpr in json.loads(pr_m.stdout or "[]"):
                                        if mpr.get("headRefOid") == head_sha and mpr.get("baseRefName") == base_branch:
                                            is_merged = True
                                            break
                            # Or exact git ancestry (only when branch has commits != base_sha)
                            if not is_merged and head_sha and head_sha != base_sha:
                                if run_cmd(git_cmd("merge-base", "--is-ancestor", head_sha, base_sha), cwd=repo_root, env_role="orchestrator").returncode == 0:
                                    is_merged = True

                        if is_merged:
                            current_ref = run_cmd(git_cmd("symbolic-ref", "-q", "HEAD"), cwd=wt, env_role="orchestrator")
                            current_sha = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=wt, check=True, env_role="orchestrator")
                            ref = f"refs/heads/{br}"
                            if current_ref.stdout.strip() != ref or current_sha.stdout.strip() != head_sha:
                                skipped.append(f"{wt.name} (branch or HEAD changed during cleanup)")
                                continue
                            _worktree_cache_path(rkey, wt.name)
                            rm_cmd = git_cmd("worktree", "remove", *(["--force"] if args.all else []), str(wt))
                            rm_res = run_cmd(rm_cmd, cwd=repo_root, env_role="orchestrator")
                            if rm_res.returncode != 0:
                                skipped.append(f"{wt.name} (remove failed: {rm_res.stderr.strip()[:120]})")
                                continue
                            if br and br not in (base_branch, "HEAD"):
                                checked_out = run_cmd(git_cmd("for-each-ref", "--format=%(worktreepath)", ref),
                                                      cwd=repo_root, check=True, env_role="orchestrator")
                                if checked_out.stdout.strip():
                                    skipped.append(f"{wt.name} (worktree removed, branch now checked out elsewhere)")
                                    continue
                                # Compare-and-delete after removing the worktree. Preserve any newer commit.
                                del_res = run_cmd(git_cmd("update-ref", "--no-deref", "-d", ref, head_sha),
                                                  cwd=repo_root, env_role="orchestrator")
                                if del_res.returncode != 0:
                                    skipped.append(f"{wt.name} (worktree removed, branch delete failed: {del_res.stderr.strip()[:100]})")
                                    continue
                            removed.append(f"{wt.name} ({br}@{head_sha[:8]})")
                        else:
                            skipped.append(f"{wt.name} ({br}@{head_sha[:8]}, unmerged or newer local commits)")
                except RuntimeError as exc:
                    skipped.append(f"{wt.name} ({redact_secrets(str(exc))})")
        run_cmd(git_cmd("worktree", "prune"), cwd=repo_root, env_role="orchestrator")

    print(safe_json({"removed": removed, "skipped": skipped}, indent=2, ensure_ascii=False))
    return 0


# ---------------------------------------------------------------------------
# CLI Entrypoint
# ---------------------------------------------------------------------------

def _positive_int(raw: str) -> int:
    val = int(raw)
    if val <= 0:
        raise argparse.ArgumentTypeError(f"must be a positive integer (got {val})")
    return val


def _rework_range_int(raw: str) -> int:
    val = int(raw)
    if val < 0 or val > 5:
        raise argparse.ArgumentTypeError(f"--max-rework must be between 0 and 5 (got {val})")
    return val


def add_exec_flags(p: argparse.ArgumentParser) -> None:
    p.add_argument("--repo", help="Target git repo path (default: current directory)")
    p.add_argument("--project", default=None, help="Explicit Linear project name or ID")
    p.add_argument("--worker", default="codex:sol@xhigh", help="Worker harness spec (default: codex:sol@xhigh)")
    p.add_argument("--reviewer", default=None, help="Reviewer harness spec (default: auto cross-vendor)")
    p.add_argument("--verify-cmd", default=None, help="Override deterministic verification command")
    p.add_argument("--setup-cmd", default=None, help="Override dependency bootstrap command for fresh worktree")
    p.add_argument("--max-rework", type=_rework_range_int, default=2, help="Max rework rounds after initial attempt (0..5, default: 2)")
    p.add_argument("--verify-timeout", type=_positive_int, default=900, help="Verify timeout seconds (default: 900)")
    p.add_argument("--setup-timeout", type=_positive_int, default=600, help="Bootstrap timeout seconds (default: 600)")
    p.add_argument("--worker-timeout", type=_positive_int, default=1800, help="Worker harness timeout seconds (default: 1800)")
    p.add_argument("--review-timeout", type=_positive_int, default=900, help="Review harness timeout seconds (default: 900)")
    p.add_argument("--no-push", action="store_true", help="Local dry run: skip Linear mutations, push, and PR")
    p.add_argument("--allow-no-verify", action="store_true", help="Allow passing when no verify command is detected")
    p.add_argument("--allow-gate-edits", action="store_true", help="Allow worker edits to protected gate/policy files")
    p.add_argument("--allow-test-edits", action="store_true", help="Allow authorized test deletions/migrations")
    p.add_argument("--allow-dirty-docs", action="store_true", help="Skip preflight check for uncommitted/unpushed domain docs")
    p.add_argument("--allow-branch-only", action="store_true", help="Allow branch-only delivery on non-GitHub remotes without Draft PR")
    p.add_argument("--skip-baseline", action="store_true", help="Skip base-commit verify baseline check")
    p.add_argument("--skip-project-check", action="store_true", help="Skip cross-repo Linear project match guard")
    p.add_argument("--force-rerun", action="store_true", help="Allow rerunning an issue already In Progress or In Review")
    p.add_argument("--fresh", action="store_true", help="Recreate worktree and branch cleanly from base (recovers dirty trees)")


def main() -> int:
    if os.environ.get("AGENT_DISPATCH_CHILD") == "1":
        print(
            safe_json({"status": "error", "error": "Nested agent-dispatch invocation blocked (AGENT_DISPATCH_CHILD=1)."}),
            file=sys.stderr,
        )
        return 2

    _install_signal_handlers()

    parser = argparse.ArgumentParser(
        prog="agent-dispatch",
        description="Production-grade cross-harness Linear -> Worktree -> Verify -> Heterogeneous Review -> Draft PR orchestrator.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_run = sub.add_parser("run", help="Run full closed-loop pipeline for one Linear ticket")
    p_run.add_argument("issue", help="Linear issue identifier (e.g., K1N-12)")
    add_exec_flags(p_run)
    p_run.set_defaults(func=cmd_run)

    p_resume = sub.add_parser("resume", help="Reconcile interrupted Option B publish from checkpoint")
    p_resume.add_argument("issue", help="Linear issue identifier (e.g., K1N-12)")
    p_resume.add_argument("--repo", default=None, help="Target git repo path")
    p_resume.add_argument("--project", default=None, help="Explicit Linear project name or ID")
    p_resume.add_argument("--skip-project-check", action="store_true", help="Skip cross-repo project check")
    p_resume.set_defaults(func=cmd_resume)

    p_front = sub.add_parser("frontier", help="Dispatch non-overlapping wave of ready Todo tickets")
    p_front.add_argument("--max-parallel", type=_positive_int, default=2, help="Max parallel worktrees (default: 2)")
    p_front.add_argument("--limit", type=_positive_int, default=None, help="Max tickets to dispatch in this wave")
    add_exec_flags(p_front)
    p_front.set_defaults(func=cmd_frontier)

    p_spec = sub.add_parser("spec", help="Dispatch current ready unblocked wave of a parent Spec issue")
    p_spec.add_argument("parent_issue", help="Parent Linear Spec identifier (e.g., K1N-10)")
    p_spec.add_argument("--max-parallel", type=_positive_int, default=2, help="Max parallel worktrees (default: 2)")
    p_spec.add_argument("--limit", type=_positive_int, default=None, help="Max tickets to dispatch in this wave")
    add_exec_flags(p_spec)
    p_spec.set_defaults(func=cmd_spec)

    p_rev = sub.add_parser("review", help="Run standalone SHA-locked heterogeneous review (Standards + optional Spec)")
    p_rev.add_argument("--repo", default=None, help="Target git repo path")
    p_rev.add_argument("--base", default=None, help="Base ref to diff against (default: origin/<default>)")
    p_rev.add_argument("--issue", default=None, help="Optional Linear issue ID for Spec axis")
    p_rev.add_argument("--reviewer", default="agy:neon", help="Reviewer harness spec (default: agy:neon)")
    p_rev.add_argument("--review-timeout", type=_positive_int, default=900, help="Review harness timeout seconds (default: 900)")
    p_rev.set_defaults(func=cmd_review)

    p_stat = sub.add_parser("status", help="Inspect Linear frontier, zombie runs, locks, and worktrees")
    p_stat.add_argument("--repo", default=None, help="Target git repo path")
    p_stat.add_argument("--project", default=None, help="Explicit Linear project name or ID")
    p_stat.set_defaults(func=cmd_status)

    p_doc = sub.add_parser("doctor", help="Preflight environment, Linear, GitHub, and repo checks")
    p_doc.add_argument("--repo", default=None, help="Target git repo path")
    p_doc.add_argument("--project", default=None, help="Explicit Linear project name or ID")
    p_doc.set_defaults(func=cmd_doctor)

    p_clean = sub.add_parser("cleanup", help="Remove merged, clean, unlocked worktrees for this repo")
    p_clean.add_argument("--repo", default=None, help="Target git repo path")
    p_clean.add_argument("--all", action="store_true", help="Force remove all unlocked worktrees even if unmerged")
    p_clean.set_defaults(func=cmd_cleanup)

    args = parser.parse_args()
    try:
        status = args.func(args)
        _check_shutdown()
        return status
    except KeyboardInterrupt:
        return 128 + signal.SIGINT
    except Exception as exc:
        print(safe_json({"status": "error", "error": redact_secrets(str(exc))}, indent=2, ensure_ascii=False), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
