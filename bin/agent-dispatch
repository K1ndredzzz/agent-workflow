def cmd_run(args: argparse.Namespace) -> int:
    repo_root = get_repo_root(args.repo)
    client = LinearClient(resolve_linear_auth())
    repo_project = None if args.skip_project_check else resolve_project(client, repo_root, args.project)
    worker = parse_harness_spec(args.worker)
    reviewer = parse_harness_spec(args.reviewer) if args.reviewer else default_reviewer_for(worker)
    if worker.vendor == reviewer.vendor:
        log(f"Warning: worker ({worker.label}) and reviewer ({reviewer.label}) share vendor '{worker.vendor}'.")
    res = execute_ticket(
        client,
        repo_root,
        repo_project,
        args.issue,
        worker,
        reviewer,
        verify_cmd_override=args.verify_cmd,
        setup_cmd_override=args.setup_cmd,
        max_rework=args.max_rework,
        verify_timeout=args.verify_timeout,
        setup_timeout=args.setup_timeout,
        worker_timeout=args.worker_timeout,
        review_timeout=args.review_timeout,
        no_push=args.no_push,
        allow_no_verify=args.allow_no_verify,
        allow_gate_edits=args.allow_gate_edits,
        allow_test_edits=args.allow_test_edits,
        allow_dirty_docs=args.allow_dirty_docs,
        allow_branch_only=args.allow_branch_only,
        skip_baseline=args.skip_baseline,
        skip_project_check=args.skip_project_check,
        force_rerun=args.force_rerun,
        fresh=args.fresh,
    )
    print(safe_json(res, indent=2, ensure_ascii=False))
    return 0 if res.get("status") in ("passed", "passed_local", "passed_branch_only") else 1


def cmd_resume(args: argparse.Namespace) -> int:
    """Acquire canonical ticket lock FIRST, load authoritative state.json, verify repo/worktree identity, and reconcile cleanly."""
    repo_root = get_repo_root(args.repo)
    rkey = repo_cache_key(repo_root)
    cur_repo_identity = canonical_repo_identity(repo_root)
    repo_common = get_git_common_dir(repo_root)
    client = LinearClient(resolve_linear_auth())
    repo_project = None if args.skip_project_check else resolve_project(client, repo_root, args.project)

    issue = client.get_issue(args.issue)
    if not args.skip_project_check and repo_project:
        if (issue.get("project") or {}).get("id") != repo_project["id"]:
            raise RuntimeError(f"Cross-repo guard: {issue['identifier']} does not belong to project '{repo_project['name']}'.")

    t_lock = ticket_lock_path(repo_root, issue["id"])
    with file_lock(t_lock, blocking=False):
        latest_file = _cache_root() / "runs" / rkey / issue["identifier"] / "latest.json"
        if not latest_file.is_file():
            raise RuntimeError(f"No checkpoint found at {latest_file}")
        try:
            latest_data = json.loads(latest_file.read_text(encoding="utf-8"))
            if not isinstance(latest_data, dict) or not latest_data.get("run_dir"):
                raise ValueError("missing run_dir")
            run_dir = Path(latest_data["run_dir"])
            state_file = run_dir / "state.json"
            # Prefer authoritative run_dir/state.json over latest.json index to avoid split-brain on mid-write crash!
            state = json.loads(state_file.read_text(encoding="utf-8")) if state_file.is_file() else latest_data
            if not isinstance(state, dict):
                raise ValueError("state is not a JSON object")
        except (OSError, ValueError) as exc:
            raise RuntimeError(f"Corrupt checkpoint at {latest_file}: {exc}") from exc
        if state.get("issue_uuid") and state["issue_uuid"] != issue["id"]:
            raise RuntimeError(f"Checkpoint issue UUID mismatch ({state['issue_uuid']} != {issue['id']}).")
        if state.get("repo_identity") and state["repo_identity"] != cur_repo_identity:
            raise RuntimeError(
                f"Checkpoint repo_identity mismatch ({state['repo_identity']} != {cur_repo_identity}); refusing cross-repo resume."
            )
        if state.get("no_push"):
            raise RuntimeError(f"Latest run for {issue['identifier']} was `--no-push` local mode; rerun without `--no-push` to publish.")
        if state.get("stage") in ("claim_pending", "claim_released"):
            live = client.get_issue(issue["id"])
            if state["stage"] == "claim_pending":
                pre_state_id = state.get("pre_claim_state_id")
                if not pre_state_id:
                    raise RuntimeError("Interrupted claim checkpoint missing pre_claim_state_id; human state preserved.")
                if live["state"]["id"] != pre_state_id:
                    # Older claim_pending records lack an assignee/description snapshot.
                    if not state.get("claimed_ownership") or live["state"]["id"] != state.get("claimed_state_id"):
                        raise RuntimeError("Cannot verify ownership of interrupted claim; human state preserved.")
                    _require_publish_ownership(live, state)
                    client.ensure_label_and_add(live, "dispatch:failed")
                    live = client.get_issue(issue["id"])
                    _require_publish_ownership(live, state)
                    client.update_issue_state_by_id(live, pre_state_id)
                state["stage"] = "claim_released"
                save_checkpoint(run_dir, latest_file, state)
            print(safe_json({"issue": issue["identifier"], "status": "claim_released", "rerun": f"agent-dispatch run {issue['identifier']}"}))
            return 0
        if state.get("stage") in ("rollback_pending", "rollback_completed"):
            pre_state_id = state.get("pre_claim_state_id")
            pre_state_name = state.get("pre_claim_state_name") or "Todo"
            if state["stage"] == "rollback_pending":
                live = client.get_issue(issue["id"])
                if not state.get("rollback_state_reverted"):
                    if not state.get("claimed_ownership") or not state.get("claimed_state_id"):
                        raise RuntimeError("Cannot verify ownership of pending rollback; human state preserved.")
                    _require_publish_ownership(live, state)
                    # CRITICAL ORDERING: add `dispatch:failed` label FIRST, THEN revert state!
                    client.ensure_label_and_add(live, "dispatch:failed")
                    live = client.get_issue(issue["id"])
                    _require_publish_ownership(live, state)
                    if pre_state_id:
                        client.update_issue_state_by_id(live, pre_state_id, label_hint=pre_state_name)
                    else:
                        client.update_issue_state(live, "Todo")
                    state["rollback_state_reverted"] = True
                    save_checkpoint(run_dir, latest_file, state)
                rollback_marker = f"<!-- agent-dispatch-rollback:{state.get('run_id', '')} -->"
                existing_comments = (live.get("comments") or {}).get("nodes", [])
                if not any(rollback_marker in (c.get("body") or "") for c in existing_comments):
                    sess_lines = [
                        f"- `{s.get('role')}` ({s.get('harness')}): `{s.get('resume_cmd') or s.get('conversation_link') or s.get('stdout_log')}`"
                        for s in (state.get("sessions") or [])
                    ]
                    reason_text = state.get("failure_reason") or state.get("error") or "Pre-publish failure (rollback recovered via resume)."
                    comment_parts = [
                        rollback_marker,
                        f"### [agent-dispatch] Halted -> Reverted to `{pre_state_name}` (`dispatch:failed`, recovered via resume)",
                        f"- **Worktree (local, NOT pushed by this run)**: `{state.get('worktree', '')}` (`{state.get('branch', '')}`)",
                        f"- **Run Logs**: `{run_dir}`",
                        f"- **Reason**:\n{redact_secrets(str(reason_text))[:2500]}",
                    ]
                    if sess_lines:
                        comment_parts += ["", "**Sessions:**", *sess_lines]
                    client.add_comment(live["id"], "\n".join(comment_parts))
                state["stage"] = "rollback_completed"
                state.pop("rollback_error", None)
                save_checkpoint(run_dir, latest_file, state)
            print(
                safe_json(
                    {
                        "issue": issue["identifier"],
                        "status": "rollback_completed",
                        "linear_state": pre_state_name,
                        "rerun": f"agent-dispatch run {issue['identifier']}",
                    },
                    indent=2,
                    ensure_ascii=False,
                )
            )
            return 0
        if (state.get("stage") not in (*PUBLISH_STAGES, *COMPLETED_STAGES)
                or (state.get("review") or {}).get("passed") is not True
                or (state.get("verify") or {}).get("passed") is not True
                or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", state.get("candidate_sha") or "")
                or state.get("branch") != f"feat/{issue['identifier'].lower()}"):
            raise RuntimeError(f"Checkpoint at {state.get('stage')!r} lacks verified publish evidence.")
        worktree = _worktree_cache_path(rkey, issue["identifier"].upper())
        if Path(state["worktree"]) != worktree:
            raise RuntimeError("Checkpoint worktree differs from the managed ticket path.")
        if not (worktree / ".git").exists():
            raise RuntimeError(f"Worktree missing at {worktree}; cannot reconcile.")
        if get_git_common_dir(worktree) != repo_common:
            raise RuntimeError(f"Worktree {worktree} does not belong to repository {repo_root}.")
        live_issue = client.get_issue(issue["id"])
        if (live_issue.get("state") or {}).get("type") in ("completed", "canceled"):
            raise RuntimeError(f"{live_issue['identifier']} is already {live_issue['state']['name']}; nothing to resume.")

        if state.get("stage") in COMPLETED_STAGES:
            ro_out = verify_completed_publish_readonly(client, live_issue, repo_root, state)
            print(safe_json(ro_out, indent=2, ensure_ascii=False))
            return 0

        reconcile_publish(
            client,
            live_issue,
            repo_root,
            run_dir,
            latest_file,
            state,
            allow_branch_only=bool(state.get("allow_branch_only")),
        )

    print(
        safe_json(
            {
                "issue": issue["identifier"],
                "status": "passed" if state.get("stage") == "completed" else "passed_branch_only",
                "reconciled": True,
                "commit": state["candidate_sha"],
                "pr_url": state.get("pr_url", ""),
                "linear_state": (live_issue.get("state") or {}).get("name"),
                "run_dir": str(run_dir),
                "sessions": state.get("sessions", []),
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0


def cmd_frontier(args: argparse.Namespace) -> int:
    repo_root = get_repo_root(args.repo)
    client = LinearClient(resolve_linear_auth())
    proj = resolve_project(client, repo_root, args.project)
    issues = client.list_project_issues(proj["id"], state_type="unstarted")
    started = client.list_project_issues(proj["id"], state_type="started")
    active_touches, active_unscoped = extract_active_touches(started)
    runnable, blocked, skipped = collect_runnable_tickets(client, issues)
    if not runnable:
        print(safe_json({"project": proj["name"], "status": "empty_frontier", "blocked": blocked, "skipped": skipped}, indent=2, ensure_ascii=False))
        return 0
    results, deferred = run_batch_safely(
        client,
        repo_root,
        proj,
        runnable,
        args,
        active_claimed_touches=active_touches,
        active_has_unscoped=active_unscoped,
    )
    print(
        safe_json(
            {
                "project": proj["name"],
                "dispatched": len(results),
                "results": results,
                "deferred_for_next_wave": deferred,
                "blocked": blocked,
                "skipped": skipped,
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0 if all(r.get("status") in ("passed", "passed_local", "passed_branch_only") for r in results) else 1


def cmd_spec(args: argparse.Namespace) -> int:
    repo_root = get_repo_root(args.repo)
    client = LinearClient(resolve_linear_auth())
    repo_project = None if args.skip_project_check else resolve_project(client, repo_root, args.project)
    parent = client.get_issue(args.parent_issue)
    if not args.skip_project_check and repo_project and (parent.get("project") or {}).get("id") != repo_project["id"]:
        raise RuntimeError(f"Cross-repo guard: parent {parent['identifier']} does not belong to project '{repo_project['name']}'.")
    children = (parent.get("children") or {}).get("nodes", [])
    if not children:
        raise RuntimeError(f"{parent['identifier']} has no child issues.")
    scheduling_project = repo_project or parent.get("project")
    if not scheduling_project:
        raise RuntimeError("Parent Spec has no Linear project for Touches reconciliation.")
    started = client.list_project_issues(scheduling_project["id"], state_type="started")
    active_touches, active_unscoped = extract_active_touches(started)
    runnable, blocked, skipped = collect_runnable_tickets(client, children)
    if not runnable:
        print(
            safe_json(
                {"parent": parent["identifier"], "status": "no_unblocked_ready_children", "blocked": blocked, "skipped": skipped},
                indent=2,
                ensure_ascii=False,
            )
        )
        return 0
    results, deferred = run_batch_safely(
        client,
        repo_root,
        scheduling_project,
        runnable,
        args,
        active_claimed_touches=active_touches,
        active_has_unscoped=active_unscoped,
    )
    print(
        safe_json(
            {
                "parent": parent["identifier"],
                "wave_dispatched": len(results),
                "results": results,
                "deferred_for_next_wave": deferred,
                "remaining_blocked": blocked,
                "note": "Merge upstream Draft PRs and mark them Done in Linear, then rerun `agent-dispatch spec` for the next wave.",
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0 if all(r.get("status") in ("passed", "passed_local", "passed_branch_only") for r in results) else 1


def cmd_review(args: argparse.Namespace) -> int:
    assert_required_rubrics_loaded()
    repo_root = get_repo_root(args.repo)
    base_ref = args.base or fetch_base_ref(repo_root, detect_default_branch(repo_root))

    base_sha = run_cmd(git_cmd("merge-base", base_ref, "HEAD"), cwd=repo_root, check=True, env_role="orchestrator").stdout.strip()
    candidate_sha = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=repo_root, check=True, env_role="orchestrator").stdout.strip()
    if run_cmd(git_cmd("status", "--porcelain"), cwd=repo_root, env_role="orchestrator").stdout.strip():
        raise RuntimeError("Working tree has uncommitted changes; commit or stash before running SHA-locked `review`.")
    if not run_cmd(git_cmd("diff", "-z", "--name-only", f"{base_sha}..{candidate_sha}", attr_source=base_sha), cwd=repo_root, check=True, env_role="orchestrator").stdout.strip("\x00"):
        raise RuntimeError(f"Empty diff between {base_sha[:8]} and {candidate_sha[:8]}.")

    reviewer = parse_harness_spec(args.reviewer or "agy:neon")
    run_dir = _cache_root() / "reviews" / f"{repo_cache_key(repo_root)}-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
    run_dir.mkdir(parents=True, exist_ok=True)
    auth_brief: Path | None = None
    auth_brief_sha256: str | None = None
    if args.issue:
        client = LinearClient(resolve_linear_auth())
        issue = client.get_issue(args.issue)
        auth_brief_content = render_issue_snapshot(issue)
        auth_brief = run_dir / "brief.md"
        atomic_write_text(auth_brief, auth_brief_content)
        auth_brief_sha256 = sha256_file(auth_brief)

    std_dir = run_dir / "baseline-standards"
    _, std_hashes = snapshot_baseline_standards(repo_root, base_sha, std_dir)
    sessions: list[dict[str, Any]] = []
    res = run_two_axis_review(
        reviewer,
        repo_root,
        run_dir,
        base_sha,
        candidate_sha,
        auth_brief,
        auth_brief_sha256,
        std_dir,
        std_hashes,
        round_num=1,
        trace_sink=sessions,
        review_timeout=args.review_timeout,
        block_added_secrets=True,
    )
    print(
        safe_json(
            {
                "reviewer": reviewer.label,
                "base_sha": base_sha,
                "candidate_sha": candidate_sha,
                "run_dir": str(run_dir),
                "sessions": sessions,
                **res,
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0 if res["passed"] else 1


def cmd_status(args: argparse.Namespace) -> int:
    repo_root = get_repo_root(args.repo)
    rkey = repo_cache_key(repo_root)
    client = LinearClient(resolve_linear_auth())
    proj = resolve_project(client, repo_root, args.project)
    unstarted = client.list_project_issues(proj["id"], state_type="unstarted")
    started = client.list_project_issues(proj["id"], state_type="started")
    runnable, blocked, skipped = collect_runnable_tickets(client, unstarted)

    wt_root = _worktree_cache_path(rkey)
    active_wts: list[dict[str, Any]] = []
    if wt_root.is_dir():
        for p in sorted(wt_root.iterdir()):
            if not p.is_dir() or p.name.startswith(".baseline-"):
                continue
            issue_uuid, _, ckpt, owner_err = read_worktree_lock_owner(repo_root, rkey, p)
            if issue_uuid:
                locked_bool = is_locked(ticket_lock_path(repo_root, issue_uuid))
                lock_state = "locked" if locked_bool else "unlocked"
            else:
                locked_bool = None
                lock_state = "unknown"
            entry: dict[str, Any] = {
                "id": p.name,
                "path": str(p),
                "locked": locked_bool,
                "lock_state": lock_state,
                "last_stage": ckpt.get("stage"),
                "pr_url": ckpt.get("pr_url"),
                "run_dir": ckpt.get("run_dir"),
            }
            if owner_err:
                entry["owner_warning"] = owner_err
            active_wts.append(entry)

    in_prog_list: list[dict[str, Any]] = []
    for i in started:
        if (i.get("children") or {}).get("nodes"):
            continue
        locked = is_locked(ticket_lock_path(repo_root, i["id"]))
        st_name = (i.get("state") or {}).get("name")
        in_prog_list.append(
            {
                "id": i["identifier"],
                "title": i["title"],
                "state": st_name,
                "active_lock": locked,
                "zombie_warning": (st_name == "In Progress" and not locked),
            }
        )

    print(
        safe_json(
            {
                "repo": str(repo_root),
                "linear_project": proj["name"],
                "frontier_ready": [
                    {"id": i["identifier"], "title": i["title"], "touches": sorted(parse_touches(i.get("description") or ""))}
                    for i in runnable
                ],
                "blocked": blocked,
                "skipped_not_ready": skipped,
                "in_progress_or_review": in_prog_list,
                "active_worktrees": active_wts,
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    checks: dict[str, Any] = {}
    ok_all = True

    missing_rubrics = [k for k in ("tdd", "standards", "spec") if not PRELOADED_REFS.get(k, "").strip()]
    checks["rubrics"] = {"ok": not missing_rubrics, "skills_root": str(SKILLS_ROOT), "missing": missing_rubrics}
    if missing_rubrics:
        ok_all = False

    try:
        client = LinearClient(resolve_linear_auth())
        teams, projects = client.list_teams_and_projects()
        team_states = {t["key"]: [s["name"] for s in (t.get("states") or {}).get("nodes", [])] for t in teams}
        checks["linear_auth"] = {"ok": True, "teams": team_states, "projects": [p["name"] for p in projects]}
    except Exception as exc:
        ok_all = False
        checks["linear_auth"] = {"ok": False, "error": redact_secrets(str(exc))}
        client = None

    try:
        gh_res = run_cmd(["gh", "auth", "status"], env_role="orchestrator")
        checks["gh_auth"] = {"ok": gh_res.returncode == 0}
        if gh_res.returncode != 0:
            ok_all = False
    except FileNotFoundError:
        ok_all = False
        checks["gh_auth"] = {"ok": False, "error": "`gh` CLI binary not found in PATH."}

    harnesses: dict[str, Any] = {}
    for name in ("codex", "agy", "opencode", "pi"):
        p = find_harness_binary(name)
        harnesses[name] = {"ok": bool(p), "path": p}
        if name in ("codex", "agy") and not p:
            ok_all = False
    checks["harnesses"] = harnesses

    try:
        repo_root = get_repo_root(args.repo)
        base_branch = detect_default_branch(repo_root)
        gh_repo = parse_github_owner_repo(repo_root)
        verify_cmd = detect_verify_command(repo_root, None)
        dirty_docs = check_dirty_docs_in_main_repo(repo_root, base_branch)
        proj_info: dict[str, Any] = {}
        if client:
            try:
                p = resolve_project(client, repo_root, args.project)
                proj_info = {"ok": True, "project": p["name"]}
            except Exception as exc:
                ok_all = False
                proj_info = {"ok": False, "error": str(exc)}
        checks["repo"] = {
            "ok": bool(verify_cmd) and not dirty_docs and proj_info.get("ok", True),
            "root": str(repo_root),
            "default_branch": base_branch,
            "github_remote": gh_repo,
            "verify_cmd": verify_cmd,
            "verify_detected": bool(verify_cmd),
            "dirty_docs": dirty_docs,
            "linear_project": proj_info,
        }
        if not verify_cmd or dirty_docs:
            ok_all = False
    except Exception as exc:
        ok_all = False
        checks["repo"] = {"ok": False, "error": str(exc)}

    print(safe_json({"ok": ok_all, "checks": checks}, indent=2, ensure_ascii=False))
    return 0 if ok_all else 1


def cleanup_baseline(repo_root: Path, rkey: str, wt: Path, force: bool) -> None:
    owner_file = _cache_root() / "baseline-owners" / rkey / wt.name
    if not owner_file.is_file() or owner_file.is_symlink() or wt.is_symlink():
        raise RuntimeError("missing baseline ownership")
    owner = json.loads(owner_file.read_text(encoding="utf-8"))
    if not isinstance(owner, dict) or not re.fullmatch(r"[0-9a-f]{64}", str(owner.get("key", ""))):
        raise RuntimeError("invalid baseline ownership")
    lock = _cache_root() / "locks" / f"baseline-{owner['key'][:16]}.lock"
    with file_lock(lock, blocking=False):
        head = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=wt, check=True, env_role="orchestrator").stdout.strip()
        branch = run_cmd(git_cmd("branch", "--show-current"), cwd=wt, check=True, env_role="orchestrator").stdout.strip()
        if branch or head != owner.get("base_sha") or wt.resolve() != get_repo_root(str(wt)):
            raise RuntimeError("baseline ownership changed")
        tracked_dirty = run_cmd(
            git_cmd("status", "--porcelain", "--untracked-files=no"), cwd=wt, check=True, env_role="orchestrator"
        ).stdout.strip()
        if tracked_dirty and not force:
            raise RuntimeError("baseline has modified tracked files")
        # Allow reclaiming detached baselines with untracked bootstrap/verify artifacts (e.g., node_modules/.venv)
        _worktree_cache_path(rkey, wt.name)
        run_cmd(git_cmd("worktree", "remove", "--force", str(wt)), cwd=repo_root, check=True, env_role="orchestrator")
        owner_file.unlink()


def cmd_cleanup(args: argparse.Namespace) -> int:
    repo_root = get_repo_root(args.repo)
    repo_common = get_git_common_dir(repo_root)
    rkey = repo_cache_key(repo_root)
    base_branch = detect_default_branch(repo_root)
    gh_repo = parse_github_owner_repo(repo_root)
    use_gh = bool(gh_repo or os.environ.get("AGENT_DISPATCH_FORCE_GH") == "1")
    wt_root = _worktree_cache_path(rkey)
    removed: list[str] = []
    skipped: list[str] = []

    with file_lock(_cache_root() / "locks" / f"repo-{rkey}.lock", blocking=True):
        base_ref = fetch_base_ref(repo_root, base_branch)
        base_sha = run_cmd(git_cmd("rev-parse", base_ref), cwd=repo_root, check=True, env_role="orchestrator").stdout.strip()

        if wt_root.is_dir():
            for wt in sorted(wt_root.iterdir()):
                if wt.is_symlink():
                    skipped.append(f"{wt.name} (symlink in worktree root; refusing delete)")
                    continue
                if not wt.is_dir():
                    continue
                if not (wt / ".git").exists():
                    skipped.append(f"{wt.name} (not a git worktree)")
                    continue
                if get_git_common_dir(wt) != repo_common:
                    skipped.append(f"{wt.name} (git-common-dir ownership mismatch; refusing delete)")
                    continue
                if wt.name.startswith(".baseline-"):
                    try:
                        cleanup_baseline(repo_root, rkey, wt, args.all)
                        removed.append(wt.name)
                    except (OSError, RuntimeError, ValueError) as exc:
                        skipped.append(f"{wt.name} ({redact_secrets(str(exc))})")
                    continue
                issue_uuid, owner_branch, _, owner_err = read_worktree_lock_owner(repo_root, rkey, wt)
                if not issue_uuid or not owner_branch:
                    skipped.append(f"{wt.name} ({owner_err or 'missing_lock_owner_metadata'}; refusing unsafe delete)")
                    continue

                try:
                    with file_lock(ticket_lock_path(repo_root, issue_uuid), blocking=False):
                        br = run_cmd(git_cmd("rev-parse", "--abbrev-ref", "HEAD"), cwd=wt, env_role="orchestrator").stdout.strip()
                        if br != owner_branch:
                            # Human switched worktree to a personal branch or detached HEAD -> NEVER delete even with --all!
                            skipped.append(
                                f"{wt.name} (branch ownership mismatch: checked out '{br}', owner '{owner_branch}'; refusing unsafe delete)"
                            )
                            continue
                        dirty = run_cmd(git_cmd("status", "--porcelain", "-z"), cwd=wt, check=True, env_role="orchestrator").stdout
                        if dirty and not args.all:
                            skipped.append(f"{wt.name} (uncommitted changes)")
                            continue
                        head_sha = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=wt, env_role="orchestrator").stdout.strip()

                        is_merged = False
                        if args.all:
                            is_merged = True
                        else:
                            # Verify merged PR matches BOTH current headRefOid AND target base_branch!
                            if use_gh and br:
                                pr_cmd = ["gh", "pr", "list", "--head", br, "--state", "merged", "--json", "number,headRefOid,baseRefName"]
                                if gh_repo:
                                    pr_cmd += ["--repo", gh_repo]
                                pr_m = run_cmd(pr_cmd, cwd=repo_root, env_role="orchestrator")
                                if pr_m.returncode == 0:
                                    for mpr in json.loads(pr_m.stdout or "[]"):
                                        if mpr.get("headRefOid") == head_sha and mpr.get("baseRefName") == base_branch:
                                            is_merged = True
                                            break
                            # Or exact git ancestry (only when branch has commits != base_sha)
                            if not is_merged and head_sha and head_sha != base_sha:
                                if run_cmd(git_cmd("merge-base", "--is-ancestor", head_sha, base_sha), cwd=repo_root, env_role="orchestrator").returncode == 0:
                                    is_merged = True

                        if is_merged:
                            current_ref = run_cmd(git_cmd("symbolic-ref", "-q", "HEAD"), cwd=wt, env_role="orchestrator")
                            current_sha = run_cmd(git_cmd("rev-parse", "HEAD"), cwd=wt, check=True, env_role="orchestrator")
                            ref = f"refs/heads/{br}"
                            if current_ref.stdout.strip() != ref or current_sha.stdout.strip() != head_sha:
                                skipped.append(f"{wt.name} (branch or HEAD changed during cleanup)")
                                continue
                            _worktree_cache_path(rkey, wt.name)
                            rm_cmd = git_cmd("worktree", "remove", *(["--force"] if args.all else []), str(wt))
                            rm_res = run_cmd(rm_cmd, cwd=repo_root, env_role="orchestrator")
                            if rm_res.returncode != 0:
                                skipped.append(f"{wt.name} (remove failed: {rm_res.stderr.strip()[:120]})")
                                continue
                            if br and br not in (base_branch, "HEAD"):
                                checked_out = run_cmd(git_cmd("for-each-ref", "--format=%(worktreepath)", ref),
                                                      cwd=repo_root, check=True, env_role="orchestrator")
                                if checked_out.stdout.strip():
                                    skipped.append(f"{wt.name} (worktree removed, branch now checked out elsewhere)")
                                    continue
                                # Compare-and-delete after removing the worktree. Preserve any newer commit.
                                del_res = run_cmd(git_cmd("update-ref", "--no-deref", "-d", ref, head_sha),
                                                  cwd=repo_root, env_role="orchestrator")
                                if del_res.returncode != 0:
                                    skipped.append(f"{wt.name} (worktree removed, branch delete failed: {del_res.stderr.strip()[:100]})")
                                    continue
                            removed.append(f"{wt.name} ({br}@{head_sha[:8]})")
                        else:
                            skipped.append(f"{wt.name} ({br}@{head_sha[:8]}, unmerged or newer local commits)")
                except RuntimeError as exc:
                    skipped.append(f"{wt.name} ({redact_secrets(str(exc))})")
        run_cmd(git_cmd("worktree", "prune"), cwd=repo_root, env_role="orchestrator")

    print(safe_json({"removed": removed, "skipped": skipped}, indent=2, ensure_ascii=False))
    return 0


# ---------------------------------------------------------------------------
# CLI Entrypoint
# ---------------------------------------------------------------------------

def _positive_int(raw: str) -> int:
    val = int(raw)
    if val <= 0:
        raise argparse.ArgumentTypeError(f"must be a positive integer (got {val})")
    return val


def _rework_range_int(raw: str) -> int:
    val = int(raw)
    if val < 0 or val > 5:
        raise argparse.ArgumentTypeError(f"--max-rework must be between 0 and 5 (got {val})")
    return val


def add_exec_flags(p: argparse.ArgumentParser) -> None:
    p.add_argument("--repo", help="Target git repo path (default: current directory)")
    p.add_argument("--project", default=None, help="Explicit Linear project name or ID")
    p.add_argument("--worker", default="codex:sol@xhigh", help="Worker harness spec (default: codex:sol@xhigh)")
    p.add_argument("--reviewer", default=None, help="Reviewer harness spec (default: auto cross-vendor)")
    p.add_argument("--verify-cmd", default=None, help="Override deterministic verification command")
    p.add_argument("--setup-cmd", default=None, help="Override dependency bootstrap command for fresh worktree")
    p.add_argument("--max-rework", type=_rework_range_int, default=2, help="Max rework rounds after initial attempt (0..5, default: 2)")
    p.add_argument("--verify-timeout", type=_positive_int, default=900, help="Verify timeout seconds (default: 900)")
    p.add_argument("--setup-timeout", type=_positive_int, default=600, help="Bootstrap timeout seconds (default: 600)")
    p.add_argument("--worker-timeout", type=_positive_int, default=1800, help="Worker harness timeout seconds (default: 1800)")
    p.add_argument("--review-timeout", type=_positive_int, default=900, help="Review harness timeout seconds (default: 900)")
    p.add_argument("--no-push", action="store_true", help="Local dry run: skip Linear mutations, push, and PR")
    p.add_argument("--allow-no-verify", action="store_true", help="Allow passing when no verify command is detected")
    p.add_argument("--allow-gate-edits", action="store_true", help="Allow worker edits to protected gate/policy files")
    p.add_argument("--allow-test-edits", action="store_true", help="Allow authorized test deletions/migrations")
    p.add_argument("--allow-dirty-docs", action="store_true", help="Skip preflight check for uncommitted/unpushed domain docs")
    p.add_argument("--allow-branch-only", action="store_true", help="Allow branch-only delivery on non-GitHub remotes without Draft PR")
    p.add_argument("--skip-baseline", action="store_true", help="Skip base-commit verify baseline check")
    p.add_argument("--skip-project-check", action="store_true", help="Skip cross-repo Linear project match guard")
    p.add_argument("--force-rerun", action="store_true", help="Allow rerunning an issue already In Progress or In Review")
    p.add_argument("--fresh", action="store_true", help="Recreate worktree and branch cleanly from base (recovers dirty trees)")


def main() -> int:
    if os.environ.get("AGENT_DISPATCH_CHILD") == "1":
        print(
            safe_json({"status": "error", "error": "Nested agent-dispatch invocation blocked (AGENT_DISPATCH_CHILD=1)."}),
            file=sys.stderr,
        )
        return 2

    _install_signal_handlers()

    parser = argparse.ArgumentParser(
        prog="agent-dispatch",
        description="Production-grade cross-harness Linear -> Worktree -> Verify -> Heterogeneous Review -> Draft PR orchestrator.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_run = sub.add_parser("run", help="Run full closed-loop pipeline for one Linear ticket")
    p_run.add_argument("issue", help="Linear issue identifier (e.g., K1N-12)")
    add_exec_flags(p_run)
    p_run.set_defaults(func=cmd_run)

    p_resume = sub.add_parser("resume", help="Reconcile interrupted Option B publish from checkpoint")
    p_resume.add_argument("issue", help="Linear issue identifier (e.g., K1N-12)")
    p_resume.add_argument("--repo", default=None, help="Target git repo path")
    p_resume.add_argument("--project", default=None, help="Explicit Linear project name or ID")
    p_resume.add_argument("--skip-project-check", action="store_true", help="Skip cross-repo project check")
    p_resume.set_defaults(func=cmd_resume)

    p_front = sub.add_parser("frontier", help="Dispatch non-overlapping wave of ready Todo tickets")
    p_front.add_argument("--max-parallel", type=_positive_int, default=2, help="Max parallel worktrees (default: 2)")
    p_front.add_argument("--limit", type=_positive_int, default=None, help="Max tickets to dispatch in this wave")
    add_exec_flags(p_front)
    p_front.set_defaults(func=cmd_frontier)

    p_spec = sub.add_parser("spec", help="Dispatch current ready unblocked wave of a parent Spec issue")
    p_spec.add_argument("parent_issue", help="Parent Linear Spec identifier (e.g., K1N-10)")
    p_spec.add_argument("--max-parallel", type=_positive_int, default=2, help="Max parallel worktrees (default: 2)")
    p_spec.add_argument("--limit", type=_positive_int, default=None, help="Max tickets to dispatch in this wave")
    add_exec_flags(p_spec)
    p_spec.set_defaults(func=cmd_spec)

    p_rev = sub.add_parser("review", help="Run standalone SHA-locked heterogeneous review (Standards + optional Spec)")
    p_rev.add_argument("--repo", default=None, help="Target git repo path")
    p_rev.add_argument("--base", default=None, help="Base ref to diff against (default: origin/<default>)")
    p_rev.add_argument("--issue", default=None, help="Optional Linear issue ID for Spec axis")
    p_rev.add_argument("--reviewer", default="agy:neon", help="Reviewer harness spec (default: agy:neon)")
    p_rev.add_argument("--review-timeout", type=_positive_int, default=900, help="Review harness timeout seconds (default: 900)")
    p_rev.set_defaults(func=cmd_review)

    p_stat = sub.add_parser("status", help="Inspect Linear frontier, zombie runs, locks, and worktrees")
    p_stat.add_argument("--repo", default=None, help="Target git repo path")
    p_stat.add_argument("--project", default=None, help="Explicit Linear project name or ID")
    p_stat.set_defaults(func=cmd_status)

    p_doc = sub.add_parser("doctor", help="Preflight environment, Linear, GitHub, and repo checks")
    p_doc.add_argument("--repo", default=None, help="Target git repo path")
    p_doc.add_argument("--project", default=None, help="Explicit Linear project name or ID")
    p_doc.set_defaults(func=cmd_doctor)

    p_clean = sub.add_parser("cleanup", help="Remove merged, clean, unlocked worktrees for this repo")
    p_clean.add_argument("--repo", default=None, help="Target git repo path")
    p_clean.add_argument("--all", action="store_true", help="Force remove all unlocked worktrees even if unmerged")
    p_clean.set_defaults(func=cmd_cleanup)

    args = parser.parse_args()
    try:
        status = args.func(args)
        _check_shutdown()
        return status
    except KeyboardInterrupt:
        return 128 + signal.SIGINT
    except Exception as exc:
        print(safe_json({"status": "error", "error": redact_secrets(str(exc))}, indent=2, ensure_ascii=False), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
